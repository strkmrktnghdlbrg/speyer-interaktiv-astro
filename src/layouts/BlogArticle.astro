---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { city } from "../data/city";
import type { Locale } from "../i18n/config";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  lead?: string;
  publishedAt?: string;       // ISO-Datum
  updatedAt?: string;
  category?: string;          // z.B. "Hotel", "Essen & Trinken", "Ratgeber"
  author?: string;
  description?: string;       // SEO-Meta
  noindex?: boolean;
  /** Optionale Breadcrumb-Pfade; wenn nicht gesetzt, wird [city.name > title] verwendet */
  breadcrumbItems?: Crumb[];
  locale?: Locale;
  alternateUrls?: { de?: string; en?: string };
}

const {
  title,
  lead,
  publishedAt,
  updatedAt,
  category,
  author = `${city.name}-Interaktiv Redaktion`,
  description,
  noindex = false,
  breadcrumbItems,
  locale = "de",
  alternateUrls,
} = Astro.props;

const metaDesc = description ?? lead ?? title;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: metaDesc,
  ...(publishedAt ? { datePublished: publishedAt } : {}),
  ...(updatedAt ? { dateModified: updatedAt } : {}),
  // Publisher/Author referenzieren die sitewide Organization aus dem
  // BaseLayout-@graph, statt eigene Organization-Nodes anzulegen.
  // Nur wenn ein abweichender Autor übergeben wird, eigener Node.
  author:
    author === `${city.name}-Interaktiv Redaktion`
      ? { "@id": `${city.domain}/#organization` }
      : { "@type": "Organization", name: author },
  publisher: { "@id": `${city.domain}/#organization` },
};

const formattedDate = publishedAt
  ? new Date(publishedAt).toLocaleDateString("de-DE", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    })
  : null;
---

<BaseLayout title={title} description={metaDesc} noindex={noindex} locale={locale} alternateUrls={alternateUrls}>
  <article class="container-page py-10">
    <Breadcrumbs items={breadcrumbItems ?? [{ label: city.name, href: "/" }, { label: title }]} />

    <header class="max-w-3xl mb-10">
      {category && (
        <p class="eyebrow mb-3">{category}</p>
      )}
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-balance leading-[1.1] mb-6" style="color: var(--color-deep-plum);">
        {title}
      </h1>
      {lead && (
        <p class="text-xl leading-relaxed mb-6" style="color: var(--color-shadow-graphite);">
          {lead}
        </p>
      )}
      <div class="flex items-center gap-3 text-sm" style="color: var(--color-slate-steel);">
        <span>von <strong style="color: var(--color-inkwell-purple);">{author}</strong></span>
        {formattedDate && (
          <>
            <span>·</span>
            <time datetime={publishedAt}>{formattedDate}</time>
          </>
        )}
      </div>
    </header>

    <div class="lg:grid lg:grid-cols-[minmax(0,48rem)_1fr] lg:gap-12 lg:items-start">
      <div>
        <!-- Mobile: einklappbares Inhaltsverzeichnis -->
        <details id="toc-mobile" class="lg:hidden mb-8 rounded-2xl border border-[var(--color-lavender-ash)] bg-[var(--color-porcelain-mist)] p-4" hidden>
          <summary class="text-sm font-bold cursor-pointer" style="color: var(--color-deep-plum);">
            {locale === "en" ? "Table of contents" : "Inhaltsverzeichnis"}
          </summary>
          <nav aria-label={locale === "en" ? "Table of contents" : "Inhaltsverzeichnis"}>
            <ul class="toc-list mt-3 space-y-1.5 text-sm"></ul>
          </nav>
        </details>

        <div class="blog-prose max-w-3xl" id="article-body">
          <slot />
        </div>
      </div>

      <!-- Desktop: sticky Inhaltsverzeichnis -->
      <aside id="toc-desktop" class="hidden lg:block lg:sticky lg:top-24 lg:self-start" hidden>
        <nav aria-label={locale === "en" ? "Table of contents" : "Inhaltsverzeichnis"}>
          <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--color-slate-steel);">
            {locale === "en" ? "On this page" : "Auf dieser Seite"}
          </p>
          <ul class="toc-list space-y-1.5 text-sm border-l border-[var(--color-lavender-ash)]"></ul>
        </nav>
      </aside>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <style>
    :global(.toc-list a) {
      display: block;
      padding: 2px 0 2px 12px;
      color: var(--color-shadow-graphite);
      text-decoration: none;
      border-left: 2px solid transparent;
      margin-left: -1px;
      line-height: 1.45;
    }
    :global(.toc-list a:hover) {
      color: var(--color-accent);
    }
    :global(.toc-list a.is-active) {
      color: var(--color-accent);
      font-weight: 600;
      border-left-color: var(--color-accent);
    }
    :global(.toc-list li[data-depth="3"] a) {
      padding-left: 26px;
      font-size: 0.8125rem;
    }
    :global(#toc-mobile .toc-list a) {
      border-left: none;
      margin-left: 0;
      padding-left: 0;
    }
    :global(#toc-mobile .toc-list li[data-depth="3"] a) {
      padding-left: 14px;
    }
  </style>

  <script is:inline>
    (function () {
      var body = document.getElementById("article-body");
      if (!body) return;
      var headings = Array.prototype.slice.call(body.querySelectorAll("h2, h3"));
      if (headings.length < 2) return;

      var used = {};
      function slugify(text) {
        return text
          .toLowerCase()
          .replace(/ä/g, "ae").replace(/ö/g, "oe").replace(/ü/g, "ue").replace(/ß/g, "ss")
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "");
      }
      headings.forEach(function (h) {
        if (!h.id) {
          var base = slugify(h.textContent || "abschnitt") || "abschnitt";
          var id = base, i = 2;
          while (document.getElementById(id) || used[id]) { id = base + "-" + i++; }
          h.id = id;
        }
        used[h.id] = true;
      });

      var containers = [document.getElementById("toc-desktop"), document.getElementById("toc-mobile")];
      containers.forEach(function (c) {
        if (!c) return;
        var list = c.querySelector(".toc-list");
        headings.forEach(function (h) {
          var li = document.createElement("li");
          li.setAttribute("data-depth", h.tagName === "H3" ? "3" : "2");
          var a = document.createElement("a");
          a.href = "#" + h.id;
          a.textContent = h.textContent;
          li.appendChild(a);
          list.appendChild(li);
        });
        c.hidden = false;
      });

      // Aktiven Abschnitt hervorheben
      var links = document.querySelectorAll(".toc-list a");
      function setActive(id) {
        links.forEach(function (a) {
          a.classList.toggle("is-active", a.getAttribute("href") === "#" + id);
        });
      }
      if ("IntersectionObserver" in window) {
        var current = null;
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) { current = entry.target.id; }
            });
            if (current) setActive(current);
          },
          { rootMargin: "-80px 0px -70% 0px", threshold: 0 }
        );
        headings.forEach(function (h) { observer.observe(h); });
      }
    })();
  </script>
</BaseLayout>
