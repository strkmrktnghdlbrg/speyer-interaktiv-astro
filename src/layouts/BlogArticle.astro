---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { city } from "../data/city";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  lead?: string;
  publishedAt?: string;       // ISO-Datum
  updatedAt?: string;
  category?: string;          // z.B. "Hotel", "Essen & Trinken", "Ratgeber"
  author?: string;
  description?: string;       // SEO-Meta
  noindex?: boolean;
  /** Optionale Breadcrumb-Pfade; wenn nicht gesetzt, wird [city.name > title] verwendet */
  breadcrumbItems?: Crumb[];
}

const {
  title,
  lead,
  publishedAt,
  updatedAt,
  category,
  author = `${city.name}-Interaktiv Redaktion`,
  description,
  noindex = false,
  breadcrumbItems,
} = Astro.props;

const metaDesc = description ?? lead ?? title;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: metaDesc,
  ...(publishedAt ? { datePublished: publishedAt } : {}),
  ...(updatedAt ? { dateModified: updatedAt } : {}),
  author: { "@type": "Organization", name: author },
  publisher: {
    "@type": "Organization",
    name: `${city.name}-Interaktiv`,
  },
};

const formattedDate = publishedAt
  ? new Date(publishedAt).toLocaleDateString("de-DE", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    })
  : null;
---

<BaseLayout title={title} description={metaDesc} noindex={noindex}>
  <article class="container-page py-10">
    <Breadcrumbs items={breadcrumbItems ?? [{ label: city.name, href: "/" }, { label: title }]} />

    <header class="max-w-3xl mb-10">
      {category && (
        <p class="eyebrow mb-3">{category}</p>
      )}
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-balance leading-[1.1] mb-6" style="color: var(--color-deep-plum);">
        {title}
      </h1>
      {lead && (
        <p class="text-xl leading-relaxed mb-6" style="color: var(--color-shadow-graphite);">
          {lead}
        </p>
      )}
      <div class="flex items-center gap-3 text-sm" style="color: var(--color-slate-steel);">
        <span>von <strong style="color: var(--color-inkwell-purple);">{author}</strong></span>
        {formattedDate && (
          <>
            <span>·</span>
            <time datetime={publishedAt}>{formattedDate}</time>
          </>
        )}
      </div>
    </header>

    <div class="blog-prose max-w-3xl">
      <slot />
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>

<style is:global>
  .blog-prose {
    color: var(--color-inkwell-purple);
    font-size: 17px;
    line-height: 1.7;
  }
  .blog-prose h2 {
    color: var(--color-deep-plum);
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.4px;
    line-height: 1.25;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .blog-prose h3 {
    color: var(--color-deep-plum);
    font-size: 21px;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .blog-prose p {
    margin-bottom: 1.1rem;
  }
  .blog-prose strong {
    color: var(--color-deep-plum);
    font-weight: 700;
  }
  .blog-prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .blog-prose a:hover {
    text-decoration-thickness: 2px;
  }
  .blog-prose ul,
  .blog-prose ol {
    margin-bottom: 1.2rem;
    padding-left: 1.5rem;
  }
  .blog-prose ul {
    list-style: disc;
  }
  .blog-prose ol {
    list-style: decimal;
  }
  .blog-prose li {
    margin-bottom: 0.4rem;
  }
  .blog-prose .callout {
    background: var(--color-porcelain-mist);
    border-left: 3px solid var(--color-accent);
    padding: 1.1rem 1.25rem;
    border-radius: 0 0.75rem 0.75rem 0;
    margin: 1.5rem 0;
  }
  .blog-prose .callout p:last-child {
    margin-bottom: 0;
  }
  .blog-prose .faq-item {
    border-top: 1px solid var(--color-lavender-ash);
    padding-top: 1.25rem;
    margin-top: 1.25rem;
  }
  .blog-prose .faq-item:first-of-type {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }
  .blog-prose .faq-item h3 {
    margin-top: 0;
    font-size: 18px;
  }
  .blog-prose .related-block {
    background: var(--color-porcelain-mist);
    border: 1px solid var(--color-lavender-ash);
    border-radius: 1rem;
    padding: 1.5rem;
    margin: 2.5rem 0;
  }
  .blog-prose .related-block h3 {
    margin-top: 0;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-accent);
    font-weight: 800;
  }
</style>
