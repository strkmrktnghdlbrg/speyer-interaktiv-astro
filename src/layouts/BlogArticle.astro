---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { city } from "../data/city";
import type { Locale } from "../i18n/config";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  lead?: string;
  publishedAt?: string;       // ISO-Datum
  updatedAt?: string;
  category?: string;          // z.B. "Hotel", "Essen & Trinken", "Ratgeber"
  author?: string;
  description?: string;       // SEO-Meta
  noindex?: boolean;
  /** Optionale Breadcrumb-Pfade; wenn nicht gesetzt, wird [city.name > title] verwendet */
  breadcrumbItems?: Crumb[];
  locale?: Locale;
  alternateUrls?: { de?: string; en?: string };
}

const {
  title,
  lead,
  publishedAt,
  updatedAt,
  category,
  author = `${city.name}-Interaktiv Redaktion`,
  description,
  noindex = false,
  breadcrumbItems,
  locale = "de",
  alternateUrls,
} = Astro.props;

const metaDesc = description ?? lead ?? title;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: metaDesc,
  ...(publishedAt ? { datePublished: publishedAt } : {}),
  ...(updatedAt ? { dateModified: updatedAt } : {}),
  author: { "@type": "Organization", name: author },
  publisher: {
    "@type": "Organization",
    name: `${city.name}-Interaktiv`,
  },
};

const formattedDate = publishedAt
  ? new Date(publishedAt).toLocaleDateString("de-DE", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    })
  : null;
---

<BaseLayout title={title} description={metaDesc} noindex={noindex} locale={locale} alternateUrls={alternateUrls}>
  <article class="container-page py-10">
    <Breadcrumbs items={breadcrumbItems ?? [{ label: city.name, href: "/" }, { label: title }]} />

    <header class="max-w-3xl mb-10">
      {category && (
        <p class="eyebrow mb-3">{category}</p>
      )}
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-balance leading-[1.1] mb-6" style="color: var(--color-deep-plum);">
        {title}
      </h1>
      {lead && (
        <p class="text-xl leading-relaxed mb-6" style="color: var(--color-shadow-graphite);">
          {lead}
        </p>
      )}
      <div class="flex items-center gap-3 text-sm" style="color: var(--color-slate-steel);">
        <span>von <strong style="color: var(--color-inkwell-purple);">{author}</strong></span>
        {formattedDate && (
          <>
            <span>·</span>
            <time datetime={publishedAt}>{formattedDate}</time>
          </>
        )}
      </div>
    </header>

    <div class="blog-prose max-w-3xl">
      <slot />
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>
