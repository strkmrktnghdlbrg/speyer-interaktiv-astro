---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getImage } from "astro:assets";
import ogDefault from "../assets/images/sights/kaiserdom.jpg";
import { city } from "../data/city";
import { affiliate, stay22Enabled } from "../data/affiliate";
import { adsense, adsenseEnabled } from "../data/adsense";
import { analytics, gtmEnabled } from "../data/analytics";
import { type Locale, htmlLang, ogLocale } from "../i18n/config";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  ogImage?: string;
  locale?: Locale;
  alternateUrls?: { de?: string; en?: string };
}

const {
  title,
  description = city.description.short,
  noindex = false,
  canonical,
  ogImage,
  locale = "de",
  alternateUrls,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, city.domain).toString();

/**
 * Standard-Social-Bild. Vorher trug keine einzige Seite ein og:image,
 * weil nirgends eines uebergeben wurde - geteilte Links blieben ohne
 * Vorschaubild. Quelle ist der lizenzgeprueste Bildbestand; relative
 * Pfade werden absolut, relative URLs akzeptiert kein Social-Netz.
 */
const ogFallback = await getImage({
  src: ogDefault,
  width: 1200,
  height: 630,
  format: "jpg",
  fit: "cover",
});
const ogImageUrl = new URL(ogImage ?? ogFallback.src, city.domain).toString();
const fullTitle = title === city.name ? `${city.name} - Stadtportal` : `${title} · ${city.name}-Interaktiv`;

const hreflangAlternates =
  alternateUrls && (alternateUrls.de || alternateUrls.en)
    ? [
        ...(alternateUrls.de ? [{ hreflang: "de", href: `${city.domain}${alternateUrls.de}` }] : []),
        ...(alternateUrls.en ? [{ hreflang: "en", href: `${city.domain}${alternateUrls.en}` }] : []),
        ...(alternateUrls.de ? [{ hreflang: "x-default", href: `${city.domain}${alternateUrls.de}` }] : []),
      ]
    : [];

// Sitewide-Entities als @graph mit stabilen @id's. Unterseiten-Schemata
// referenzieren `${city.domain}/#organization` statt eigene Organization-
// Nodes anzulegen, sonst entstehen doppelte Entities.
// Betreiber (legalName) = Impressum dieser Domain (src/data/legal.ts).
import { legal } from "../data/legal";
const siteGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${city.domain}/#organization`,
      name: `${city.name}-Interaktiv`,
      legalName: legal.companyName,
      url: `${city.domain}/`,
      logo: {
        "@type": "ImageObject",
        url: `${city.domain}/favicon.svg`,
      },
      email: legal.email,
    },
    {
      "@type": "WebSite",
      "@id": `${city.domain}/#website`,
      name: `${city.name}-Interaktiv`,
      url: `${city.domain}/`,
      description: city.description.long,
      inLanguage: ["de", "en"],
      publisher: { "@id": `${city.domain}/#organization` },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${city.domain}/suche/?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalUrl} />
    {hreflangAlternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    {/* Selbst gehostete Schriften (DSGVO) — kritische Latin-Schnitte vorladen */}
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Consent Mode v2, Default alles denied — MUSS vor AdSense/GTM stehen.
        Googles CMP (AdSense Privacy & messaging) aktualisiert die Defaults
        nach der Banner-Entscheidung; bis dahin setzen Google-Tags keine
        Cookies und senden nur cookielose Pings. is:inline zwingend, sonst
        kann Astro die Reihenfolge gegen die Tag-Snippets tauschen. */}
    {(adsenseEnabled || gtmEnabled) && (
      <script
        is:inline
        set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',functionality_storage:'denied',personalization_storage:'denied',security_storage:'granted',wait_for_update:500});gtag('set','ads_data_redaction',true);gtag('set','url_passthrough',false);`}
      />
    )}

    {/* !noindex: Stay22s LetMeAllez schreibt ALLE GYG-/Booking-Links der
        Seite in Affiliate-Deeplinks um — auf den (noindex) Rechtsseiten
        traf das die Datenschutz-Links der Anbieter. Kein noindex-Dokument
        rendert Stay22-Widgets, der Loader wird dort also nicht gebraucht. */}
    {stay22Enabled && !noindex && (
      <script
        is:inline
        set:html={`(function(s,t,a,y,twenty,two){s.Stay22=s.Stay22||{};s.Stay22.params={lmaID:'${affiliate.stay22.lmaId}'};twenty=t.createElement(a);two=t.getElementsByTagName(a)[0];twenty.async=1;twenty.src=y;two.parentNode.insertBefore(twenty,two);})(window,document,'script','https://scripts.stay22.com/letmeallez.js');`}
      />
    )}

    {affiliate.getYourGuide.enabled && affiliate.getYourGuide.partnerId.length > 0 && (
      <script
        async
        defer
        src="https://widget.getyourguide.com/dist/pa.umd.production.min.js"
        data-gyg-partner-id={affiliate.getYourGuide.partnerId}
      ></script>
    )}

    {adsenseEnabled && !noindex && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense.publisherId}`}
        crossorigin="anonymous"
      ></script>
    )}

    {gtmEnabled && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${analytics.gtmId}');`} />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    {gtmEnabled && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${analytics.gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <a href="#main-content" class="skip-link">
      {locale === "en" ? "Skip to content" : "Zum Inhalt springen"}
    </a>
    <Header locale={locale} alternateUrls={alternateUrls} />
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
