---
/**
 * Designter Placeholder für Einträge ohne Foto.
 * ----------------------------------------------
 * Kein "kaputtes Bild", sondern bewusstes Design: gedämpfter
 * Marken-Gradient (--hue-1..5), dezentes Raster, ein Icon passend
 * zum Inhaltstyp (kind) und der Name als Wortmarke.
 */
import type { PlaceholderKind } from "../lib/placeholder";

interface Props {
  hue: number;
  className?: string;
  label?: string;
  kind?: PlaceholderKind;
}

const { hue, className = "", label, kind = "generic" } = Astro.props;

const safeHue = Math.min(Math.max(hue, 1), 5);

// Inline-SVG-Pfade (stroke-basiert, 24x24 Viewbox) je Inhaltstyp
const iconPaths: Record<PlaceholderKind, string> = {
  // Bauwerk/Denkmal — Säulenfassade
  sight:
    '<path d="M3 21h18M4 21V10m4 11V10m4 11V10m4 11V10m4 11V10M2 10h20L12 3 2 10z"/>',
  // Besteck
  restaurant:
    '<path d="M7 3v7a2 2 0 0 0 2 2v9M9 3v5M5 3v5m11.5-5c-1.5 1.5-2 4-2 6.5 0 2 .5 3 2 3V21m0-18c1.5 1.5 2 4 2 6.5 0 2-.5 3-2 3"/>',
  // Bett
  hotel:
    '<path d="M2 17v-6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v6M2 17h20M2 17v3m20-3v3M6 9V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"/><circle cx="8" cy="12" r="1"/>',
  // Häuser/Quartier
  district:
    '<path d="M3 21h18M4 21v-8l4-3 4 3v8m0-8 4-5 5 5v8M9 21v-4h2v4"/>',
  // Wimpelkette
  fest:
    '<path d="M3 5h18M4 5l2.5 4L9 5m2 0 2.5 4L16 5m2 0 2 3.5M6 21l6-8 6 8"/>',
  // Dokument
  article:
    '<path d="M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v5h5M9 12h6M9 16h6"/>',
  // Kompassnadel
  generic:
    '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5 5-2z"/>',
};
---

<div
  class={`relative w-full h-full overflow-hidden ${className}`}
  style={`background: var(--hue-${safeHue});`}
  aria-hidden="true"
>
  <!-- Dezentes Raster, damit die Fläche gestaltet statt leer wirkt -->
  <svg class="absolute inset-0 w-full h-full opacity-[0.12]" aria-hidden="true">
    <defs>
      <pattern id={`hue-grid-${safeHue}`} width="28" height="28" patternUnits="userSpaceOnUse">
        <path d="M 28 0 L 0 0 0 28" fill="none" stroke="white" stroke-width="1" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#hue-grid-${safeHue})`} />
  </svg>

  <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-4">
    <span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/20 backdrop-blur-[2px] ring-1 ring-white/30">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="white"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={iconPaths[kind]}
      />
    </span>
    {label && (
      <span
        class="text-white/95 text-sm sm:text-base font-bold tracking-wide drop-shadow text-center text-balance"
        style="font-family: var(--font-display);"
      >
        {label}
      </span>
    )}
  </div>
</div>
