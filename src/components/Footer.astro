---
import { Image } from "astro:assets";
import { city } from "../data/city";
import { districts } from "../data/districts";
import { categories } from "../data/categories";
import { features } from "../data/features";
import logo from "../assets/branding/logo.svg";
import { type Locale, homeUrl, indexUrl, detailUrl } from "../i18n/config";
import { t, tf } from "../i18n/ui";
import { districtsEn } from "../i18n/en/districts";
import { categoriesEn } from "../i18n/en/categories";

interface Props {
  locale?: Locale;
}
const { locale = "de" } = Astro.props;
const isEn = locale === "en";
const year = new Date().getFullYear();

const districtLink = (slug: string) =>
  isEn ? detailUrl("districts", districtsEn[slug]?.slug ?? slug, "en") : `/stadtteile/${slug}/`;
const districtName = (slug: string, fallback: string) =>
  isEn ? districtsEn[slug]?.name ?? fallback : fallback;
const categoryLink = (slug: string) =>
  isEn ? detailUrl("categories", categoriesEn[slug]?.slug ?? slug, "en") : `/kategorien/${slug}/`;
const categoryName = (slug: string, fallback: string) =>
  isEn ? categoriesEn[slug]?.name ?? fallback : fallback;

// Die Service- und Ratgeberseiten waren bis August 2026 aus dem gesamten
// Seitenbaum nicht verlinkt und nur ueber die Sitemap erreichbar - klassische
// Waisen. Sie stehen deshalb hier fest im Footer.
const vorOrt = [
  { href: "/parken-in-speyer/", label: "Parken in Speyer" },
  { href: "/tourist-information-speyer/", label: "Tourist-Information" },
  { href: "/speyer-mit-kindern/", label: "Speyer mit Kindern" },
  { href: "/minigolf-speyer/", label: "Minigolf in Speyer" },
  { href: "/top-10-hotels-speyer/", label: "Top 10 Hotels" },
  { href: "/wellness-hotels-speyer/", label: "Wellness-Hotels" },
  { href: "/apotheken-speyer/", label: "Apotheken" },
  { href: "/banken-in-speyer/", label: "Banken" },
  { href: "/promis-in-speyer/", label: "Promis aus Speyer" },
];
---

<footer class="mt-20 border-t border-[var(--color-lavender-ash)] bg-[var(--color-porcelain-mist)]">
  <div class="container-page py-14">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-10">
      <div class="col-span-2 md:col-span-1">
        <a href={homeUrl(locale)} class="inline-flex mb-4" style="color: var(--color-accent);" aria-label={`${city.name}-Interaktiv`}>
          <Image
            src={logo}
            alt={`${city.name}-Interaktiv`}
            width={280}
            height={64}
            class="h-12 w-auto"
          />
        </a>
        <p class="text-sm leading-relaxed" style="color: var(--color-shadow-graphite);">
          {isEn
            ? "Speyer - two thousand years of history between the Imperial Cathedral and the Rhine. Attractions, hotels, neighborhoods and festivals on one portal."
            : city.description.short}
        </p>
      </div>

      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--color-inkwell-purple);">
          {t(locale, "footer.districts")}
        </h4>
        <ul class="space-y-2">
          {districts.slice(0, 8).map((d) => (
            <li>
              <a
                href={districtLink(d.slug)}
                class="text-sm hover:underline"
                style="color: var(--color-shadow-graphite); text-underline-offset: 3px;"
              >
                {districtName(d.slug, d.name)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--color-inkwell-purple);">
          {t(locale, "footer.categories")}
        </h4>
        <ul class="space-y-2">
          {categories.slice(0, 8).map((c) => (
            <li>
              <a
                href={categoryLink(c.slug)}
                class="text-sm hover:underline"
                style="color: var(--color-shadow-graphite); text-underline-offset: 3px;"
              >
                {categoryName(c.slug, c.name)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {!isEn && (
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--color-inkwell-purple);">
            Vor Ort
          </h4>
          <ul class="space-y-2">
            {vorOrt.map((l) => (
              <li>
                <a href={l.href} class="text-sm hover:underline" style="color: var(--color-shadow-graphite); text-underline-offset: 3px;">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--color-inkwell-purple);">
          {t(locale, "footer.service")}
        </h4>
        <ul class="space-y-2">
          {!isEn && features.werben.enabled && (
            <li><a href="/werben/" class="text-sm hover:underline" style="color: var(--color-shadow-graphite); text-underline-offset: 3px;">{tf(locale, "footer.advertise", { site: city.name })}</a></li>
          )}
          {!isEn && features.branchen.enabled && (
            <li><a href="/branchenverzeichnis/" class="text-sm hover:underline" style="color: var(--color-shadow-graphite); text-underline-offset: 3px;">Branchenverzeichnis</a></li>
          )}
          {!isEn && (
            <li><a href="/kontakt/" class="text-sm hover:underline" style="color: var(--color-shadow-graphite); text-underline-offset: 3px;">Kontakt</a></li>
          )}
          {features.reiseplaner.enabled && (
            <li><a href={indexUrl("guides", locale)} class="text-sm hover:underline" style="color: var(--color-shadow-graphite); text-underline-offset: 3px;">{t(locale, "nav.guides")}</a></li>
          )}
          <li><a href={indexUrl("categories", locale)} class="text-sm hover:underline" style="color: var(--color-shadow-graphite); text-underline-offset: 3px;">{t(locale, "footer.categories")}</a></li>
          <li><a href={indexUrl("feste", locale)} class="text-sm hover:underline" style="color: var(--color-shadow-graphite); text-underline-offset: 3px;">{t(locale, "nav.feste")}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-[var(--color-lavender-ash)] flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <p class="text-xs" style="color: var(--color-slate-steel);">
        © {tf(locale, "footer.copyright", { year, site: city.name })}
      </p>
      <div class="flex items-center gap-5 flex-wrap">
        <a href={indexUrl("about", locale)} class="text-xs hover:underline" style="color: var(--color-slate-steel); text-underline-offset: 3px;">{t(locale, "nav.about")}</a>
        <a href={indexUrl("imprint", locale)} class="text-xs hover:underline" style="color: var(--color-slate-steel); text-underline-offset: 3px;">{t(locale, "nav.imprint")}</a>
        <a href={indexUrl("privacy", locale)} class="text-xs hover:underline" style="color: var(--color-slate-steel); text-underline-offset: 3px;">{t(locale, "nav.privacy")}</a>
        {/* Widerruf der Einwilligung: oeffnet die Revocation-Message von
            Googles CMP (Funding Choices). Kein eigenes Banner bauen! */}
        <button
          type="button"
          class="text-xs hover:underline cursor-pointer"
          style="color: var(--color-slate-steel); text-underline-offset: 3px;"
          onclick="if(window.googlefc&&window.googlefc.showRevocationMessage){window.googlefc.showRevocationMessage();}else if(window.googlefc&&window.googlefc.callbackQueue){window.googlefc.callbackQueue.push(function(){window.googlefc.showRevocationMessage();});}"
        >{isEn ? "Cookie settings" : "Cookie-Einstellungen"}</button>
        <a href="/bildnachweis/" class="text-xs hover:underline" style="color: var(--color-slate-steel); text-underline-offset: 3px;">{isEn ? "Image credits" : "Bildnachweis"}</a>
        <a href={indexUrl("terms", locale)} class="text-xs hover:underline" style="color: var(--color-slate-steel); text-underline-offset: 3px;">{t(locale, "nav.terms")}</a>
      </div>
    </div>
  </div>
</footer>
