---
import ContentImage from "./ContentImage.astro";
import type { Sight } from "../data/sights";
import { getDistrict } from "../data/districts";
import { type Locale, detailUrl } from "../i18n/config";
import { tf } from "../i18n/ui";
import { sightsEn } from "../i18n/en/sights";
import { districtsEn } from "../i18n/en/districts";

interface Props {
  sight: Sight;
  locale?: Locale;
}

const { sight, locale = "de" } = Astro.props;
const isEn = locale === "en";
const district = getDistrict(sight.district);
const en = isEn ? sightsEn[sight.slug] : undefined;

const href = isEn ? detailUrl("sights", en!.slug, "en") : `/sehenswuerdigkeiten/${sight.slug}/`;
const name = en?.name ?? sight.name;
const typeLabel = en?.type ?? sight.type;
const shortDesc = en?.shortDesc ?? sight.shortDesc;
const districtName = isEn ? (districtsEn[sight.district]?.name ?? district?.name ?? sight.district) : (district?.name ?? sight.district);
const freeLabel = isEn ? "Free" : "Gratis";
const priceLabel =
  sight.priceFrom === null
    ? (isEn ? "Free entry" : "Eintritt frei")
    : tf(locale, "detail.priceFrom", { n: sight.priceFrom }).replace("EUR", "€");
---

<a href={href} class="card group block">
  <div class="aspect-[4/3] relative overflow-hidden">
    <ContentImage
      imgKey={sight.imageKey}
      fallbackHue={sight.imageHue}
      fallbackLabel={name}
      imgClass="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute top-3 left-3">
      <span class="pill bg-white/95 backdrop-blur-sm">
        {typeLabel}
      </span>
    </div>
    {sight.priceFrom === null && (
      <div class="absolute top-3 right-3">
        <span class="pill-accent">{freeLabel}</span>
      </div>
    )}
  </div>
  <div class="p-3">
    <p class="text-xs font-semibold mb-1" style="color: var(--color-slate-steel);">
      {districtName}
    </p>
    <h3
      class="text-base font-bold tracking-tight leading-tight mb-2 group-hover:text-[var(--color-accent)] transition-colors"
      style="color: var(--color-deep-plum);"
    >
      {name}
    </h3>
    <p class="text-xs leading-relaxed line-clamp-2 mb-2" style="color: var(--color-shadow-graphite);">
      {shortDesc}
    </p>
    <p class="text-xs font-semibold" style="color: var(--color-accent);">
      {priceLabel}
    </p>
  </div>
</a>
