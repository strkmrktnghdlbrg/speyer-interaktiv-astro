---
import { Image } from "astro:assets";
import HueGradient from "./HueGradient.astro";
import type { PlaceholderKind } from "../lib/placeholder";
import { getImage } from "../data/images";

interface Props {
  imgKey?: string;
  fallbackHue?: number;
  fallbackLabel?: string;
  /** Inhaltstyp für das Placeholder-Icon (sight/restaurant/hotel/district/fest/article) */
  kind?: PlaceholderKind;
  className?: string;
  imgClass?: string;
  loading?: "lazy" | "eager";
  aspect?: string;
  sizes?: string;          // Responsive sizes-Hint (z.B. "(min-width: 1024px) 25vw, 50vw")
  widths?: number[];       // Generierte Breite-Varianten (Default: [400, 800, 1200, 1600])
}

const {
  imgKey,
  fallbackHue = 1,
  fallbackLabel,
  kind = "generic",
  className = "",
  imgClass = "w-full h-full object-cover",
  loading = "lazy",
  aspect,
  sizes = "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw",
  widths = [400, 800, 1200, 1600],
} = Astro.props;

const entry = imgKey ? getImage(imgKey) : undefined;
// Ohne aspect ist der ELTERN-Container der Rahmen (Hero, Kartenkachel). Die
// figure muss ihn dann ausfuellen - sonst hat sie Hoehe auto, das h-full am
// <img> laeuft ins Leere, das Bild behaelt seine natuerliche Hoehe und der
// Container schneidet einfach unten ab. Genau deshalb war immer nur der obere
// Bildrand zu sehen und object-position ohne jede Wirkung.
const wrapperClass = aspect ? `${aspect} ${className}` : `h-full w-full ${className}`;
---

{entry ? (
  <figure class={`relative ${wrapperClass}`}>
    <Image
      src={entry.src}
      alt={entry.alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      decoding="async"
      format="webp"
      quality={78}
      class={imgClass}
    />

    {entry.illustrative && (
      <span class="absolute bottom-3 right-3 px-2 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wide bg-black/60 text-white backdrop-blur-sm">
        Symbolbild
      </span>
    )}
  </figure>
) : (
  <div class={`relative w-full h-full min-h-[220px] ${wrapperClass}`}>
    <HueGradient hue={fallbackHue} label={fallbackLabel} kind={kind} />
  </div>
)}
