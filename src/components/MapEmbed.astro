---
/**
 * OpenStreetMap-Embed via iframe.
 * --------------------------------
 * Kostenlos, kein API-Key, kein Tracking, GDPR-freundlich.
 * Alternative wäre Mapbox Static API — würde aber API-Key + Hosting-Trafficlimit
 * verbrauchen. OSM-Embed reicht für Sight-Detail-Karten.
 *
 * Dokumentation: https://www.openstreetmap.org/export
 */

import { type Locale } from "../i18n/config";
import { t } from "../i18n/ui";

interface Props {
  lat: number;
  lng: number;
  /** Karten-Zoomstufe. 15 = ~250m visible. */
  zoom?: number;
  /** Label für den Marker (wird im OSM-iframe als pin gerendert). */
  label?: string;
  /** Container-Höhe Tailwind-Klasse. */
  heightClass?: string;
  /** Optionaler Titel über der Karte. */
  title?: string;
  locale?: Locale;
}

const { lat, lng, zoom = 15, label, heightClass = "h-[320px] sm:h-[400px]", title, locale = "de" } = Astro.props;
const mapWord = t(locale, "map.attribution");

// OSM-Embed-Bbox: kleines Fenster um Koordinate (zoom-abhängig)
const span = zoom >= 16 ? 0.004 : zoom >= 14 ? 0.012 : 0.04;
const bbox = [lng - span, lat - span / 2, lng + span, lat + span / 2].join(",");
const embedUrl = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lng}`;
const externalUrl = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=${zoom}/${lat}/${lng}`;
---

<section class="my-10">
  {title && (
    <h2 class="text-xl sm:text-2xl font-bold tracking-tight mb-3" style="color: var(--color-deep-plum);">
      {title}
    </h2>
  )}
  <div class={`relative rounded-2xl overflow-hidden border border-[var(--color-lavender-ash)] ${heightClass}`}>
    <iframe
      src={embedUrl}
      title={label ? `${mapWord} ${label}` : t(locale, "map.eyebrow")}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      style="border:0; width:100%; height:100%; display:block;"
    ></iframe>
  </div>
  <p class="text-[11px] mt-2" style="color: var(--color-slate-steel);">
    {mapWord} <a href={externalUrl} target="_blank" rel="noopener" class="underline hover:no-underline">{locale === "en" ? "OpenStreetMap contributors" : "OpenStreetMap-Mitwirkende"}</a>
    {label && ` · ${label}`}
  </p>
</section>
