---
/**
 * Cookie-Consent-Banner (GDPR-konform, minimal).
 * ------------------------------------------------
 * Lädt Stay22/GYG/GTM/AdSense erst nach Consent. Wird im BaseLayout
 * eingebunden, blockiert KEINE statisch gerenderten HTML-Inhalte —
 * nur die Tracking-Scripts. Consent-Status wird in localStorage gespeichert.
 *
 * Drei Buttons: "Akzeptieren" (alle Cookies an), "Nur essenziell"
 * (Tracking aus), "Einstellungen" (Link zur Datenschutzseite).
 *
 * Pattern: das Banner setzt window.__consent.marketing = true|false
 * und löst CustomEvent "consent:changed" aus. Tracking-Scripts in
 * BaseLayout prüfen vor dem Laden auf den Wert.
 */
---

<div
  id="cookie-consent"
  class="hidden fixed bottom-0 left-0 right-0 z-[100] p-4 sm:p-6 border-t shadow-[0_-8px_32px_rgba(0,0,0,0.12)]"
  style="background: #fff; border-color: var(--color-lavender-ash);"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-text"
>
  <div class="container-page flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex-1 max-w-3xl">
      <h2 id="cookie-consent-title" class="text-base font-bold mb-1.5" style="color: var(--color-deep-plum);">
        Cookies und Tracking
      </h2>
      <p id="cookie-consent-text" class="text-sm leading-relaxed" style="color: var(--color-shadow-graphite);">
        Wir verwenden Cookies und Drittanbieter-Tools (Stay22 für Hotel-Affiliate,
        GetYourGuide für Touren, GTM für Analytics) für Funktionen und Marketing.
        Du kannst dein Einverständnis jederzeit widerrufen. Details in der
        <a href="/datenschutz/" class="underline hover:no-underline" style="color: var(--color-accent);">Datenschutzerklärung</a>.
      </p>
    </div>
    <div class="flex flex-col sm:flex-row gap-2 shrink-0">
      <button
        type="button"
        id="cookie-consent-essential"
        class="px-4 py-2.5 text-sm font-semibold rounded-xl border transition-colors hover:bg-[var(--color-porcelain-mist)]"
        style="border-color: var(--color-lavender-ash); color: var(--color-shadow-graphite);"
      >
        Nur essenziell
      </button>
      <button
        type="button"
        id="cookie-consent-accept"
        class="px-5 py-2.5 text-sm font-semibold rounded-xl text-white transition-colors"
        style="background: var(--color-accent);"
      >
        Alle akzeptieren
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = "speyer-consent-v1";
    var banner = document.getElementById("cookie-consent");
    if (!banner) return;

    function readConsent() {
      try { return JSON.parse(localStorage.getItem(KEY) || "null"); } catch { return null; }
    }
    function writeConsent(val) {
      try { localStorage.setItem(KEY, JSON.stringify({ marketing: val, at: new Date().toISOString() })); } catch {}
      window.__consent = { marketing: val };
      window.dispatchEvent(new CustomEvent("consent:changed", { detail: { marketing: val } }));
    }

    var existing = readConsent();
    if (existing && typeof existing.marketing === "boolean") {
      window.__consent = { marketing: existing.marketing };
      // Banner bleibt versteckt, falls schon entschieden
    } else {
      window.__consent = { marketing: false };
      banner.classList.remove("hidden");
    }

    document.getElementById("cookie-consent-accept")?.addEventListener("click", function () {
      writeConsent(true);
      banner.classList.add("hidden");
      // Tracking-Scripts dynamisch nachladen, damit der erste Pageview tracked wird
      window.location.reload();
    });
    document.getElementById("cookie-consent-essential")?.addEventListener("click", function () {
      writeConsent(false);
      banner.classList.add("hidden");
    });
  })();
</script>
