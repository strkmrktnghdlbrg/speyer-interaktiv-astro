---
import BaseLayout from "../layouts/BaseLayout.astro";
import SightCard from "../components/SightCard.astro";
import HotelCard from "../components/HotelCard.astro";
import RestaurantCard from "../components/RestaurantCard.astro";
import DistrictCard from "../components/DistrictCard.astro";
import NewsCard from "../components/NewsCard.astro";
import GetYourGuideWidget from "../components/GetYourGuideWidget.astro";
import { getTopHotels, type Stay22Accommodation } from "../lib/stay22";
import { city } from "../data/city";
import { affiliate } from "../data/affiliate";
import { features } from "../data/features";
import { sights } from "../data/sights";
import { hotels } from "../data/hotels";
import { publishedRestaurants as restaurants } from "../data/restaurants";
import { districts } from "../data/districts";
import { recentNews } from "../data/news";

const topSights = sights.slice(0, 4);
const topHotels = hotels.slice(0, 4);

// Live-Hotels via Stay22 (Build-Time). Liefert echte Bilder, aktuelle
// Preise + Reisedaten. Fallback auf statische HotelCards, falls die API
// beim Build nicht erreichbar ist (graceful degradation).
let liveTopHotels: Stay22Accommodation[] | null = null;
try {
  liveTopHotels = await getTopHotels(
    `${city.name}, Deutschland`,
    affiliate.stay22.apiAid,
    { limit: 4 },
  );
} catch (err) {
  console.error("[index] Stay22 Live-Hotels Build-Fetch fehlgeschlagen:", err);
}
const hasLiveHotels = !!liveTopHotels && liveTopHotels.length > 0;
const hotelBuildDate = new Date().toLocaleDateString("de-DE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const topRestaurants = restaurants.slice(0, 4);
const featuredDistricts = districts.slice(0, 4);
const latestNews = recentNews(3);

// Organization + WebSite kommen sitewide als @graph aus dem BaseLayout
// (stabile @id's). Hier keinen eigenen Block mehr ausspielen, sonst
// entstehen doppelte Entities.
---

<BaseLayout title={city.name} description={city.description.short} alternateUrls={{ de: "/", en: "/en/" }}>
  <section
    class="relative overflow-hidden"
    style="background: linear-gradient(135deg, var(--color-deep-plum) 0%, var(--color-inkwell-purple) 60%, var(--color-accent) 100%);"
  >
    <div class="absolute inset-0 opacity-20" aria-hidden="true">
      <div class="absolute top-10 left-10 w-72 h-72 rounded-full" style="background: radial-gradient(circle, rgba(255,255,255,0.4) 0%, transparent 70%);"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 rounded-full" style="background: radial-gradient(circle, rgba(240,85,55,0.5) 0%, transparent 70%);"></div>
    </div>

    <div class="container-page py-20 sm:py-28 lg:py-32 relative">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-widest text-white/80 mb-4">
          Das Stadtportal für {city.name}
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white text-balance leading-[1.05]">
          Was läuft heute in {city.name}?
        </h1>
        <p class="mt-6 text-lg sm:text-xl leading-relaxed text-white/85 max-w-2xl">
          {city.description.long}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/sehenswuerdigkeiten/" class="btn-primary bg-white" style="color: var(--color-accent); background: #ffffff;">
            Sehenswürdigkeiten entdecken
          </a>
          <a href={features.reiseplaner.enabled ? "/reiseplaner/" : "/hotels/"} class="btn-ghost bg-white/10 border-white/30 text-white hover:bg-white/20" style="color: white; background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.3);">
            {features.reiseplaner.enabled ? "Reiseplaner" : "Hotels"}
          </a>
        </div>
        <dl class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-2xl">
          {[
            { label: "Sehenswürdigkeiten", value: city.stats.sights },
            { label: "Hotels", value: city.stats.hotels },
            { label: "Restaurants", value: city.stats.restaurants },
            { label: "Stadtteile", value: city.stats.districts },
          ].map((s) => (
            <div>
              <dd class="text-3xl font-bold text-white">{s.value}</dd>
              <dt class="text-xs uppercase tracking-widest text-white/70 mt-1">{s.label}</dt>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section container-page">
    <div class="flex items-end justify-between mb-8">
      <div>
        <p class="eyebrow mb-2">Sehenswürdigkeiten</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight" style="color: var(--color-deep-plum);">
          {city.name} in einem Tag erleben
        </h2>
      </div>
      <a href="/sehenswuerdigkeiten/" class="hidden sm:inline-flex link-accent font-semibold text-sm">
        Alle Sights →
      </a>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {topSights.map((s) => <SightCard sight={s} />)}
    </div>
  </section>

  <section class="section container-page" style="background: var(--color-porcelain-mist); border-radius: 24px;">
    <div class="px-4 sm:px-8">
      <div class="flex items-end justify-between mb-8">
        <div>
          <p class="eyebrow mb-2">Hotels</p>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight" style="color: var(--color-deep-plum);">
            Übernachten mit Stil
          </h2>
        </div>
        <a href="/hotels/" class="hidden sm:inline-flex link-accent font-semibold text-sm">
          Alle Hotels →
        </a>
      </div>
      {hasLiveHotels ? (
        <>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            {liveTopHotels!.map((h) => (
              <a
                href={h.link || "#"}
                target="_blank"
                rel="sponsored noopener nofollow"
                class="card group block overflow-hidden hover:shadow-lg transition-all"
              >
                <div class="aspect-[4/3] relative overflow-hidden bg-[var(--color-porcelain-mist)]">
                  {h.image ? (
                    <img
                      src={h.image}
                      alt={h.name}
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer-when-downgrade"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  ) : (
                    <div class="w-full h-full" style="background: var(--color-porcelain-mist);"></div>
                  )}
                  <div class="absolute top-3 left-3 flex flex-col gap-1.5">
                    {h.rating?.score && (
                      <span class="pill-accent">{h.rating.score.toFixed(1)} / 10</span>
                    )}
                    {h.starRating && (
                      <span class="pill bg-white/95 backdrop-blur-sm">{"★".repeat(Math.round(h.starRating))}</span>
                    )}
                  </div>
                </div>
                <div class="p-3">
                  {h.address?.areaName && (
                    <p class="text-xs font-semibold mb-1" style="color: var(--color-slate-steel);">
                      {h.address.areaName}
                    </p>
                  )}
                  <h3
                    class="text-base font-bold tracking-tight leading-tight mb-2 group-hover:text-[var(--color-accent)] transition-colors line-clamp-2"
                    style="color: var(--color-deep-plum);"
                  >
                    {h.name}
                  </h3>
                  {(h.price?.formattedPerNight || h.price?.formattedTotal) && (
                    <div>
                      <p class="text-xs" style="color: var(--color-slate-steel);">ab</p>
                      <p class="text-base font-bold" style="color: var(--color-deep-plum);">
                        {h.price?.formattedPerNight ?? h.price?.formattedTotal}
                        <span class="text-xs font-normal" style="color: var(--color-slate-steel);">
                          {h.price?.formattedPerNight ? " / Nacht" : ""}
                        </span>
                      </p>
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
          <p class="text-[11px] mt-4 leading-relaxed" style="color: var(--color-slate-steel);">
            * Sponsored - Buchung läuft über Booking.com via Stay22-Affiliate.
            Live-Preise und Verfügbarkeit, Stand: {hotelBuildDate}. Preise und
            Reisedaten ändern sich täglich.
          </p>
        </>
      ) : (
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {topHotels.map((h) => <HotelCard hotel={h} />)}
        </div>
      )}
    </div>
  </section>

  <section class="section container-page">
    <div class="flex items-end justify-between mb-8">
      <div>
        <p class="eyebrow mb-2">Essen gehen</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight" style="color: var(--color-deep-plum);">
          Weinstube, Brauhaus und Sterne-Küche
        </h2>
      </div>
      <a href="/restaurants/" class="hidden sm:inline-flex link-accent font-semibold text-sm">
        Alle Restaurants →
      </a>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {topRestaurants.map((r) => <RestaurantCard restaurant={r} />)}
    </div>
  </section>

  <section class="section container-page">
    <div class="flex items-end justify-between mb-8">
      <div>
        <p class="eyebrow mb-2">Stadtteile</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight" style="color: var(--color-deep-plum);">
          {city.name} nach Quartier
        </h2>
      </div>
      <a href="/stadtteile/" class="hidden sm:inline-flex link-accent font-semibold text-sm">
        Alle Stadtteile →
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {featuredDistricts.map((d) => <DistrictCard district={d} />)}
    </div>
  </section>

  <section class="container-page">
    <GetYourGuideWidget
      mode="city"
      cityQuery={affiliate.getYourGuide.cityQuery}
      numberOfItems={4}
      cmp="homepage-city"
      title={`Top-Touren in ${city.name}`}
      lead={`Die meistgebuchten Erlebnisse für deine ${city.name}-Reise. Tickets direkt online buchen, kostenfrei stornierbar.`}
    />
  </section>

  {features.news.enabled && (
    <section class="section container-page">
      <div class="flex items-end justify-between mb-8">
        <div>
          <p class="eyebrow mb-2">Aktuelles</p>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight" style="color: var(--color-deep-plum);">
            News aus der Stadt
          </h2>
        </div>
        <a href="/news/" class="hidden sm:inline-flex link-accent font-semibold text-sm">
          Alle News →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {latestNews.map((n) => <NewsCard item={n} />)}
      </div>
    </section>
  )}

  <!-- Apotheken & Gesundheit -->
  <section class="section container-page">
    <div class="apo-home">
      <p class="apo-home-eyebrow">Gesundheit</p>
      <h2 class="apo-home-h2">Apotheken in Speyer: Adressen, Notdienst, Versand</h2>
      <p>In der Altstadt und entlang der Maximilianstraße sind die Wege kurz, in Speyer-Nord, Speyer-West und im Edith-Stein-Viertel verteilt sich die Versorgung. Abends und an Feiertagen entscheidet der Notdienstplan. Welche Apotheken es gibt und wie du die diensthabende findest, steht bei den <a href="/apotheken-speyer/">Apotheken in Speyer</a>.</p>
      <p>Alles ohne Eile lässt sich günstiger bestellen. Bei rezeptfreien Medikamenten und Pflegeprodukten liegen Versandapotheken oft unter dem Preis vor Ort, wenn der Mindestbestellwert passt. Lieferzeiten und Konditionen für Speyer stehen im <a href="/online-apotheke-speyer/">Online-Apotheken-Vergleich</a>.</p>
      <h2 class="apo-home-h2" style="margin-top: 2rem;">Fotobox für Feiern in der Domstadt</h2>
      <p>Hochzeit am Dom, Firmenfeier am Rheinufer, Geburtstag in der Vorderpfalz: Eine Fotobox hält die Abende fest - vom kompakten Standardmodell bis zum Retro-Fotobus, der sich in die historische Kulisse einfügt. Welche Variante wozu passt, wie Anbieter kalkulieren und was man in der Altstadt beim Stellplatz beachten muss, steht im Ratgeber <a href="/fotobox-mieten-speyer/">Fotobox mieten in Speyer</a>.</p>
    </div>
  </section>

  <section class="section container-page">
    <div
      class="relative overflow-hidden rounded-3xl p-8 sm:p-12"
      style="background: linear-gradient(120deg, var(--color-accent) 0%, var(--color-accent-hover) 100%);"
    >
      <div class="relative grid md:grid-cols-2 gap-8 items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-white/80 mb-3">
            Für Unternehmen
          </p>
          {/*
            Hier stand "Werbe vor Speyerer Lesern pro Monat" samt Monatspreisen
            von 49 €, 149 € und "ab 250 €". Auf /werben/ gibt es aber 199 € pro
            JAHR und sonst "auf Anfrage" - keine Monatstarife, kein Banner-
            produkt. Startseite und Angebotsseite muessen dasselbe sagen.
            Gleiche Korrektur wie auf koeln-interaktiv f13d1f3.
          */}
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight mb-4">
            Dein Betrieb ganz oben in seiner Branche
          </h2>
          <p class="text-white/90 leading-relaxed mb-6">
            Premium-Eintrag im Branchenverzeichnis mit Logo, Beschreibung und
            Backlink. Dazu gesponserte Artikel und Newsletter-Platzierungen auf
            Anfrage. Das Angebot richtet sich an Unternehmer.
          </p>
          <a href="/werben/" class="btn-primary bg-white" style="color: var(--color-accent); background: white;">
            Werbe-Pakete ansehen →
          </a>
        </div>
        <div class="hidden md:block">
          <div class="grid grid-cols-2 gap-3">
            {[
              { label: "Basis-Eintrag", price: "0 €", desc: "im Branchenverzeichnis" },
              { label: "Premium-Partner", price: "199 €", desc: "pro Jahr zzgl. USt" },
              { label: "Gesponserter Artikel", price: "auf Anfrage", desc: "gekennzeichnet, lektoriert" },
              { label: "Newsletter", price: "auf Anfrage", desc: "Kanal im Aufbau" },
            ].map((t) => (
              <div class="bg-white/15 backdrop-blur-sm rounded-2xl p-4 border border-white/20">
                <p class="text-xs font-bold uppercase tracking-widest text-white/70 mb-1">{t.label}</p>
                <p class="text-2xl font-bold text-white">{t.price}</p>
                <p class="text-xs text-white/70 mt-0.5">{t.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Apotheken-Teaser (Startseite) */
  .apo-home { max-width: 70ch; }
  .apo-home-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; opacity: .6; margin: 0 0 8px;
  }
  .apo-home-h2 {
    font-size: clamp(24px, 3.2vw, 32px); font-weight: 600; line-height: 1.15;
    letter-spacing: -.02em; margin: 0 0 14px;
  }
  .apo-home p { font-size: 1rem; line-height: 1.75; margin: 0 0 12px; opacity: .88; }
  .apo-home p:last-child { margin-bottom: 0; }
  .apo-home a {
    color: inherit; font-weight: 600; text-decoration: underline;
    text-underline-offset: 3px; text-decoration-thickness: 1px;
  }
  .apo-home a:hover { text-decoration-thickness: 2px; }
</style>
