---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HotelCard from "../../components/HotelCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Stay22Map from "../../components/Stay22Map.astro";
import Stay22TopHotels from "../../components/Stay22TopHotels.astro";
import GetYourGuideWidget from "../../components/GetYourGuideWidget.astro";
import { hotels } from "../../data/hotels";
import { city } from "../../data/city";

const sorted = [...hotels].sort((a, b) => b.rating - a.rating);
---

<BaseLayout title={`Hotels in ${city.name}`} description={`Hotels in ${city.name}, von 3 bis 5 Sternen, sortiert nach Bewertung. Direkter Booking-Link, beste Preisgarantie.`}>
  <div class="container-page py-10">
    <Breadcrumbs items={[{ label: city.name, href: "/" }, { label: "Hotels" }]} />

    <div class="max-w-3xl mb-10">
      <p class="eyebrow mb-2">Übernachten</p>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4" style="color: var(--color-deep-plum);">
        Hotels in {city.name}
      </h1>
      <p class="text-lg leading-relaxed" style="color: var(--color-shadow-graphite);">
        Von der Domhof-Tradition bis zur Designherberge, von der Altstadt bis zum Rheinhafen.
        Alle Hotels mit Bewertung, Preis ab und direktem Booking-Link.
      </p>
    </div>

    <Stay22Map
      title={`${city.name} auf einen Blick`}
      lead="Alle Hotels mit Live-Preisen und Verfügbarkeit. Klick auf einen Marker zeigt Details."
      zoom={13}
    />

    <Stay22TopHotels
      title={`Aktuell bestbewertete Hotels in ${city.name}`}
      lead="Live von Booking.com via Stay22. Frische Preise und Bewertungen, aktualisiert bei jedem Build."
      limit={8}
    />

    <div class="my-6 flex flex-wrap items-center gap-3">
      <a href="/top-10-hotels-speyer/" class="btn-outline">
        Top 10 Hotels in {city.name} →
      </a>
      <a href="/hotels-speyer-brezelfest/" class="btn-outline">
        Hotels zum Brezelfest →
      </a>
      <a href="/hotels-speyer-weihnachtsmarkt/" class="btn-outline">
        Hotels zum Weihnachtsmarkt →
      </a>
    </div>

    <h2 class="text-2xl font-bold tracking-tight mt-12 mb-6" style="color: var(--color-deep-plum);">
      Kuratierte Hotel-Auswahl
    </h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {sorted.map((h) => <HotelCard hotel={h} />)}
    </div>

    <GetYourGuideWidget offerKey="page:hotels" />
  </div>
</BaseLayout>
