---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { city } from "../data/city";

const stadt = city.name; // "Speyer"

type Bezug = "lebt aktuell" | "geboren" | "aufgewachsen" | "hat lange gelebt" | "eng verbunden";
interface Person {
  name: string;
  kategorie: string;
  bezug: Bezug;
  fakt: string;
}

const personen: Person[] = [
  { name: "Lars Stindl", kategorie: "Sport", bezug: "geboren", fakt: "Der Fußball-Nationalspieler und langjährige Kapitän von Borussia Mönchengladbach wurde 1988 in Speyer geboren." },
  { name: "Brajan Gruda", kategorie: "Sport", bezug: "geboren", fakt: "Der deutsch-albanische Fußballprofi und Nachwuchstalent wurde 2004 in Speyer geboren." },
  { name: "Anselm Feuerbach", kategorie: "Kunst", bezug: "geboren", fakt: "Der bedeutende Maler des Idealismus mit mythologischen Motiven wurde 1829 in Speyer geboren." },
  { name: "Hans Purrmann", kategorie: "Kunst", bezug: "geboren", fakt: "Der Maler und Kunstschriftsteller aus dem Umfeld von Henri Matisse wurde 1880 in Speyer geboren." },
  { name: "Henry Villard", kategorie: "Wirtschaft", bezug: "geboren", fakt: "Der Journalist und US-Eisenbahnmagnat, der die Northern Pacific Railway leitete, wurde 1835 in Speyer geboren." },
  { name: "Stefanie Seiler", kategorie: "Politik", bezug: "geboren", fakt: "Die aktuelle Oberbürgermeisterin von Speyer (SPD) wurde 1983 in der Stadt geboren." },
  { name: "Hannah Neumann", kategorie: "Politik", bezug: "geboren", fakt: "Die Europaabgeordnete von Bündnis 90/Die Grünen wurde 1984 in Speyer geboren." },
  { name: "Karl Gayer", kategorie: "Wissenschaft", bezug: "geboren", fakt: "Der einflussreiche Forstwissenschaftler und Verfechter des naturgemäßen Waldbaus wurde 1822 in Speyer geboren." },
];

const faq = [
  { frage: "Welcher Fußballer kommt aus Speyer?", antwort: "Der bekannteste Fußballer aus Speyer ist Nationalspieler Lars Stindl, der 1988 dort geboren wurde. Auch das Talent Brajan Gruda stammt aus Speyer." },
  { frage: "Welcher berühmte Maler stammt aus Speyer?", antwort: "Der bedeutendste Maler aus Speyer ist Anselm Feuerbach, geboren 1829, ein Hauptvertreter des deutschen Idealismus." },
  { frage: "Wer ist die Oberbürgermeisterin von Speyer?", antwort: "Oberbürgermeisterin von Speyer ist Stefanie Seiler (SPD), die 1983 selbst in der Stadt geboren wurde." },
  { frage: "Gibt es weltbekannte Persönlichkeiten aus Speyer?", antwort: "Ja, unter anderem der US-Eisenbahnmagnat Henry Villard, der 1835 in Speyer geboren wurde und später die Northern Pacific Railway in den USA leitete." },
];

// Reihenfolge der Kategorien
const kategorien = [...new Set(personen.map((p) => p.kategorie))];

const bezugLabel: Record<Bezug, string> = {
  "lebt aktuell": `lebt in ${stadt}`,
  geboren: `geboren in ${stadt}`,
  aufgewachsen: `aufgewachsen in ${stadt}`,
  "hat lange gelebt": `lange in ${stadt} gelebt`,
  "eng verbunden": `eng mit ${stadt} verbunden`,
};

const h1 = `Welche Promis leben in ${stadt}?`;
const seoTitle = `Welche Promis leben in ${stadt}? Bekannte Persönlichkeiten`;
const description = `Welche Promis kommen aus Speyer? Von Fußball-Nationalspieler Lars Stindl über Maler Anselm Feuerbach bis zu Talent Brajan Gruda - bekannte Persönlichkeiten der Domstadt im Überblick.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: h1,
      description,
      inLanguage: "de-DE",
      about: { "@type": "Place", name: stadt },
      mainEntityOfPage: new URL(Astro.url.pathname, city.domain).toString(),
    },
    {
      "@type": "ItemList",
      name: `Bekannte Persönlichkeiten aus ${stadt}`,
      itemListElement: personen.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: { "@type": "Person", name: p.name, description: p.fakt },
      })),
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.frage,
        acceptedAnswer: { "@type": "Answer", text: f.antwort },
      })),
    },
  ],
};
---

<BaseLayout title={seoTitle} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <section class="container-page py-10">
    <Breadcrumbs items={[{ label: stadt, href: "/" }, { label: `Promis in ${stadt}` }]} />

    <div class="max-w-3xl">
      <p class="eyebrow mb-3">Bekannte Persönlichkeiten</p>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-6 text-balance" style="color: var(--color-inkwell-purple);">
        {h1}
      </h1>
      <p class="text-lg leading-relaxed mb-6" style="color: var(--color-shadow-graphite);">
        Die Domstadt {stadt} am Rhein hat bekannte Persönlichkeiten aus Sport, Kunst und Politik hervorgebracht. Von Fußball-Nationalspieler Lars Stindl über den Maler Anselm Feuerbach bis zum US-Eisenbahnmagnaten Henry Villard reicht die Liste der prominenten Namen. Hier findest du einen Überblick über Promis, die in {stadt} geboren wurden oder eng mit der Stadt verbunden sind.
      </p>
      <p class="text-sm leading-relaxed mb-10" style="color: var(--color-shadow-graphite);">
        Hinweis: Die folgende Übersicht umfasst Persönlichkeiten, die in {stadt} geboren oder aufgewachsen sind, lange hier gelebt haben oder eng mit der Stadt verbunden sind. Jeder Eintrag ist entsprechend gekennzeichnet.
      </p>
    </div>

    {kategorien.map((kat) => (
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl font-bold mb-5" style="color: var(--color-inkwell-purple);">{kat}</h2>
        <ul class="space-y-4">
          {personen.filter((p) => p.kategorie === kat).map((p) => (
            <li class="card p-5">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-2">
                <span class="text-lg font-bold" style="color: var(--color-inkwell-purple);">{p.name}</span>
                <span class="text-xs font-semibold px-2.5 py-1" style={`background: var(--color-accent-tint); color: var(--color-accent); border-radius: var(--radius-badge);`}>
                  {bezugLabel[p.bezug]}
                </span>
              </div>
              <p class="leading-relaxed" style="color: var(--color-shadow-graphite);">{p.fakt}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="max-w-3xl mt-14">
      <h2 class="text-2xl font-bold mb-6" style="color: var(--color-inkwell-purple);">Häufige Fragen zu Promis aus {stadt}</h2>
      <div class="space-y-4">
        {faq.map((f) => (
          <details class="card p-5">
            <summary class="font-semibold cursor-pointer" style="color: var(--color-inkwell-purple);">{f.frage}</summary>
            <p class="mt-3 leading-relaxed" style="color: var(--color-shadow-graphite);">{f.antwort}</p>
          </details>
        ))}
      </div>
    </div>

    <div class="max-w-3xl mt-14 pt-8 border-t" style="border-color: var(--color-lavender-ash);">
      <h2 class="text-xl font-bold mb-4" style="color: var(--color-inkwell-purple);">Mehr über {stadt}</h2>
      <ul class="flex flex-wrap gap-3">
        <li><a href="/sehenswuerdigkeiten/" class="underline" style="color: var(--color-accent); text-underline-offset: 3px;">Sehenswürdigkeiten in {stadt}</a></li>
        <li><a href="/" class="underline" style="color: var(--color-accent); text-underline-offset: 3px;">Startseite {stadt}-Interaktiv</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
