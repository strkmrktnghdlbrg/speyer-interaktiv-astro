---
import BlogArticle from "../../layouts/BlogArticle.astro";
import GetYourGuideWidget from "../../components/GetYourGuideWidget.astro";
import ContentImage from "../../components/ContentImage.astro";
import { feste, getFest } from "../../data/feste";
import { city } from "../../data/city";

export function getStaticPaths() {
  return feste.map((f) => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
const item = getFest(slug!)!;

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: item.name,
  description: item.shortDesc,
  location: {
    "@type": "Place",
    name: `${city.name} Altstadt`,
    address: {
      "@type": "PostalAddress",
      addressLocality: city.name,
      addressRegion: "Rheinland-Pfalz",
      addressCountry: "DE",
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: city.coordinates[0],
      longitude: city.coordinates[1],
    },
  },
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  description2: item.termin,
  organizer: {
    "@type": "Organization",
    name: `Stadt ${city.name}`,
    url: `https://www.${city.slug}.de`,
  },
  ...(item.websiteUrl ? { url: item.websiteUrl } : {}),
  inLanguage: "de-DE",
};
---

<BlogArticle
  title={item.name}
  lead={item.lead}
  description={item.shortDesc}
  category="Fest"
>
  <div class="aspect-[16/9] relative overflow-hidden rounded-2xl mb-6">
    <ContentImage
      imgKey={item.imageKey}
      fallbackHue={item.imageHue}
      fallbackLabel={item.name}
      showCredit
      loading="eager"
      sizes="(min-width: 1024px) 768px, 100vw"
    />
  </div>

  <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] mb-2">
    {item.termin}
  </p>

  <p class="text-ink-700 leading-relaxed">
    {item.lead}
  </p>

  {item.websiteUrl && (
    <p class="mt-6">
      <a
        href={item.websiteUrl}
        rel="nofollow noopener"
        target="_blank"
        class="inline-flex items-center gap-1.5 rounded-xl px-5 py-2.5 text-sm font-semibold text-white transition-colors"
        style="background: var(--color-accent);"
      >
        Offizielle Website {item.name} →
      </a>
    </p>
  )}

  <GetYourGuideWidget offerKey={`fest:${item.slug}`} />

  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} is:inline />
</BlogArticle>
