---
import BlogArticle from "../../layouts/BlogArticle.astro";
import GetYourGuideWidget from "../../components/GetYourGuideWidget.astro";
import ContentImage from "../../components/ContentImage.astro";
import Stay22NearbyHotels from "../../components/Stay22NearbyHotels.astro";
import { feste, getFest } from "../../data/feste";
import { festeEn } from "../../i18n/en/feste";
import { city } from "../../data/city";

export function getStaticPaths() {
  return feste.map((f) => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
const item = getFest(slug!)!;

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: item.name,
  description: item.shortDesc,
  location: {
    "@type": "Place",
    name: `${city.name} Altstadt`,
    address: {
      "@type": "PostalAddress",
      addressLocality: city.name,
      addressRegion: "Rheinland-Pfalz",
      addressCountry: "DE",
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: city.coordinates[0],
      longitude: city.coordinates[1],
    },
  },
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  // startDate/endDate nur, wenn die Termine offiziell bestätigt sind. Bei
  // Festen, deren Termin nur als Freitext vorliegt ("11.11. bis
  // Aschermittwoch"), waere ein ISO-Datum geraten und bleibt deshalb weg.
  ...(item.startDate ? { startDate: item.startDate } : {}),
  ...(item.endDate ? { endDate: item.endDate } : {}),
  organizer: {
    "@type": "Organization",
    name: `Stadt ${city.name}`,
    url: `https://www.${city.slug}.de`,
  },
  ...(item.websiteUrl ? { url: item.websiteUrl } : {}),
  inLanguage: "de-DE",
};

const faqSchema = item.guide
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: item.guide.faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;
---

<BlogArticle
  title={item.headline ?? item.name}
  seoTitle={item.seoTitle}
  lead={item.lead}
  description={item.shortDesc}
  category="Fest"
  alternateUrls={festeEn[item.slug] ? { de: `/feste/${item.slug}/`, en: `/en/festivals/${festeEn[item.slug].slug}/` } : undefined}
>
  <div class="aspect-[16/9] relative overflow-hidden rounded-2xl mb-6">
    <ContentImage
      kind="fest"
      imgKey={item.imageKey}
      fallbackHue={item.imageHue}
      fallbackLabel={item.name}
      loading="eager"
      sizes="(min-width: 1024px) 768px, 100vw"
    />
  </div>

  <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] mb-2">
    {item.termin}
  </p>

  <p class="text-ink-700 leading-relaxed">
    {item.lead}
  </p>

  {item.websiteUrl && (
    <p class="mt-6">
      <a
        href={item.websiteUrl}
        rel="nofollow noopener"
        target="_blank"
        class="inline-flex items-center gap-1.5 rounded-xl px-5 py-2.5 text-sm font-semibold text-white transition-colors"
        style="background: var(--color-accent);"
      >
        Offizielle Website {item.name} →
      </a>
    </p>
  )}

  {item.guide && (
    <>
      <h2 id="termin-ort">Termin &amp; Ort</h2>
      {item.guide.terminOrt.map((p) => <p>{p}</p>)}

      {item.guide.oeffnungszeiten && (
        <>
          <h2 id="oeffnungszeiten">Öffnungszeiten</h2>
          <table>
            <thead>
              <tr><th>Tage</th><th>Zeiten</th></tr>
            </thead>
            <tbody>
              {item.guide.oeffnungszeiten.map((z) => (
                <tr><td>{z.tage}</td><td>{z.zeit}</td></tr>
              ))}
            </tbody>
          </table>
          {item.guide.sonderzeiten && (
            <>
              <h3 id="sonderoeffnungszeiten">Abweichende Zeiten an Feiertagen</h3>
              <table>
                <thead>
                  <tr><th>Tag</th><th>Zeiten</th></tr>
                </thead>
                <tbody>
                  {item.guide.sonderzeiten.map((z) => (
                    <tr><td>{z.tag}</td><td>{z.zeit}</td></tr>
                  ))}
                </tbody>
              </table>
            </>
          )}
        </>
      )}

      {item.guide.angebot && (
        <>
          <h2 id="angebot">Stände und Angebot</h2>
          {item.guide.angebot.map((p) => <p>{p}</p>)}
        </>
      )}

      {item.guide.neujahrsmarkt && (
        <>
          <h2 id="neujahrsmarkt">Neujahrsmarkt: der Markt nach dem Jahreswechsel</h2>
          {item.guide.neujahrsmarkt.map((p) => <p>{p}</p>)}
        </>
      )}

      <h2 id="anreise">Anreise</h2>
      {item.guide.anreise.map((p) => <p>{p}</p>)}

      {item.guide.parken && (
        <>
          <h2 id="parken">Parken</h2>
          {item.guide.parken.map((p) => <p>{p}</p>)}
          <p>
            <a href="/parken-in-speyer/" class="font-semibold hover:underline" style="color: var(--color-accent); text-underline-offset: 3px;">
              Alle Parkhäuser, Tarife und kostenfreien Alternativen im Überblick
            </a>
          </p>
        </>
      )}

      <h2 id="tipps">Tipps für den Besuch</h2>
      <ul>
        {item.guide.tipps.map((t) => <li>{t}</li>)}
      </ul>

      <h2 id="umgebung">In der Umgebung</h2>
      <ul>
        {item.guide.umgebung.map((u) => (
          <li>
            <a href={u.href} class="font-semibold hover:underline" style="color: var(--color-accent); text-underline-offset: 3px;">
              {u.label}
            </a>
          </li>
        ))}
      </ul>

      <h2 id="faq">Häufige Fragen</h2>
      <div class="space-y-3 not-prose">
        {item.guide.faq.map((f) => (
          <details class="card p-4">
            <summary class="font-semibold cursor-pointer" style="color: var(--color-deep-plum);">{f.q}</summary>
            <p class="mt-2 text-sm leading-relaxed" style="color: var(--color-shadow-graphite);">{f.a}</p>
          </details>
        ))}
      </div>

      <p class="mt-6 text-xs" style="color: var(--color-slate-steel);">
        Stand: {item.guide.stand}. Termine und Details veröffentlicht der Veranstalter jeweils vor Saisonbeginn.
        {item.guide.quelle && (
          <>
            {" "}Quelle der Termin- und Zeitangaben:{" "}
            <a href={item.guide.quelle.url} rel="nofollow noopener" target="_blank" class="underline">
              {item.guide.quelle.label}
            </a>.
          </>
        )}
      </p>
    </>
  )}

  {item.geo && (
    <Stay22NearbyHotels lat={item.geo.lat} lng={item.geo.lng} near={item.geo.label} radius={1500} limit={4} />
  )}

  {item.hotelEventSlug && (
    <p class="mt-4">
      <a href={`/hotels-speyer-${item.hotelEventSlug}/`} class="font-semibold hover:underline" style="color: var(--color-accent); text-underline-offset: 3px;">
        Hotels in Speyer für {item.headline ?? item.name} mit Preisen für den Reisezeitraum
      </a>
    </p>
  )}

  <GetYourGuideWidget offerKey={`fest:${item.slug}`} />

  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} is:inline />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />}
</BlogArticle>
