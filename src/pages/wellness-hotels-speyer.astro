---
/**
 * Top Wellness-Hotels Speyer (evergreen Top-Liste).
 * --------------------------------------------------
 * Live von Stay22, gefiltert auf Hotels mit Spa/Wellness im Speyer-Umkreis
 * (Stay22 hat keinen amenities-Filter, daher filtern wir nachträglich auf
 * den Hotel-Namen — Lindner Binshof, Diakonissen-Spa-Bereich, Karlsruhe-
 * Hotels mit Wellness etc.).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import GetYourGuideWidget from "../components/GetYourGuideWidget.astro";
import { searchAccommodations, type Stay22Accommodation } from "../lib/stay22";
import { affiliate } from "../data/affiliate";
import { city } from "../data/city";

const lmaId = affiliate.stay22.apiAid;
let hotels: Stay22Accommodation[] | null = null;
try {
  hotels = await searchAccommodations({
    provider: "booking",
    address: `${city.name}, Deutschland`,
    type: "hotel",
    minguestrating: 8.0,
    minstarrating: 4,
    limit: 20,
    currency: "EUR",
    lang: "de",
    aid: lmaId,
    campaign: lmaId,
  });
} catch (err) {
  console.error("[wellness-hotels] Stay22-Fetch:", err);
}

// Wellness-Heuristik: Name enthält Spa, Wellness, Therme, Resort, oder
// gehört zur Lindner-Kette. Fällt nichts: Top 10 zeigen.
const WELLNESS_HINTS = /spa|wellness|therm|resort|lindner|sole|kurhotel/i;
let wellness = (hotels ?? []).filter((h) => WELLNESS_HINTS.test(h.name));
if (wellness.length === 0) wellness = (hotels ?? []).slice(0, 10);
wellness = wellness.slice(0, 10);

const buildDate = new Date().toLocaleDateString("de-DE", {
  year: "numeric", month: "long", day: "numeric",
});
const description = `Wellness-Hotels in ${city.name} und Umgebung - mit Spa, Sauna, Pool und Therapieangeboten. Live-Preise aus Booking.com via Stay22. Stand: ${buildDate}.`;

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Wellness-Hotels in ${city.name}`,
  description,
  numberOfItems: wellness.length,
  itemListElement: wellness.map((h, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Hotel",
      name: h.name,
      url: h.link,
      ...(h.starRating ? { starRating: { "@type": "Rating", ratingValue: h.starRating } } : {}),
      ...(h.rating?.score ? {
      } : {}),
    },
  })),
};
---

<BaseLayout title={`Wellness-Hotels in ${city.name}`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

  <div class="container-page py-10">
    <Breadcrumbs items={[
      { label: city.name, href: "/" },
      { label: "Hotels", href: "/hotels/" },
      { label: "Wellness" },
    ]} />

    <div class="max-w-3xl mb-10">
      <p class="eyebrow mb-2">Wellness in der Pfalz</p>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4" style="color: var(--color-deep-plum);">
        Wellness-Hotels in {city.name}
      </h1>
      <p class="text-lg leading-relaxed mb-3" style="color: var(--color-shadow-graphite);">
        Pfalz und Wellness gehören zusammen. Vom Lindner & Spa Binshof bis zu
        Wellness-Hotels mit Pool, Sauna und Anwendungen - hier findest du Live-Preise
        aktuell verfügbarer Wellness-Adressen in {city.name} und Umgebung. Daten
        kommen direkt aus dem Stay22-Inventar.
      </p>
      <p class="text-sm" style="color: var(--color-slate-steel);">Stand: {buildDate}</p>
    </div>

    {wellness.length === 0 ? (
      <div class="card p-6 max-w-3xl">
        <p style="color: var(--color-shadow-graphite);">
          Stay22 liefert gerade keine Live-Daten. Schau in unseren
          <a href="/hotels/" class="link-accent font-semibold">Hotel-Index</a>.
        </p>
      </div>
    ) : (
      <ol class="space-y-6">
        {wellness.map((h, i) => (
          <li class="card overflow-hidden grid sm:grid-cols-[260px_1fr] gap-0">
            {h.image && (
              <div class="aspect-[4/3] sm:aspect-auto sm:h-full overflow-hidden bg-[var(--color-porcelain-mist)]">
                <img src={h.image} alt={h.name} loading="lazy" decoding="async"
                  referrerpolicy="no-referrer-when-downgrade"
                  class="w-full h-full object-cover" />
              </div>
            )}
            <div class="p-5 sm:p-6 flex flex-col">
              <div class="flex items-start gap-3 mb-3">
                <span class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full font-bold text-sm"
                      style="background: var(--color-accent-tint); color: var(--color-accent);">
                  {i + 1}
                </span>
                <div class="flex-1">
                  <div class="flex flex-wrap items-center gap-2 mb-1.5">
                    {h.starRating && (
                      <span class="text-xs font-bold" style="color: var(--color-accent);">
                        {"★".repeat(Math.round(h.starRating))}
                      </span>
                    )}
                    {h.rating?.score && (
                      <span class="pill-accent text-[10px]">{Number.isInteger(h.rating.score) ? h.rating.score : h.rating.score.toFixed(1)} / 10</span>
                    )}
                  </div>
                  <h2 class="text-xl font-bold leading-tight mb-1" style="color: var(--color-deep-plum);">
                    {h.name}
                  </h2>
                  {h.address?.areaName && (
                    <p class="text-xs" style="color: var(--color-slate-steel);">
                      {h.address.areaName}{h.address.cityName ? `, ${h.address.cityName}` : ""}
                    </p>
                  )}
                </div>
              </div>
              <div class="mt-auto flex flex-wrap items-end justify-between gap-3 pt-2">
                {(h.price?.formattedPerNight || h.price?.formattedTotal) && (
                  <div>
                    <p class="text-xs" style="color: var(--color-slate-steel);">ab</p>
                    <p class="text-2xl font-bold" style="color: var(--color-deep-plum);">
                      {h.price?.formattedPerNight ?? h.price?.formattedTotal}
                      <span class="text-xs font-normal ml-1" style="color: var(--color-slate-steel);">
                        {h.price?.formattedPerNight ? "/ Nacht" : "gesamt"}
                      </span>
                    </p>
                  </div>
                )}
                <a href={h.link || "#"} target="_blank" rel="sponsored noopener nofollow" class="btn-primary">
                  Verfügbarkeit prüfen →
                </a>
              </div>
            </div>
          </li>
        ))}
      </ol>
    )}

    <p class="text-[11px] mt-8 leading-relaxed max-w-3xl" style="color: var(--color-slate-steel);">
      * Sponsored - Buchung läuft über Booking.com via Stay22-Affiliate. Wir
      filtern auf 4-Sterne-Plus und Wellness-Hinweise im Hotel-Namen. Falls dir
      ein Hotel mit Spa-Bereich auffällt, das hier fehlen sollte, freuen wir uns
      über einen Hinweis.
    </p>

    <GetYourGuideWidget offerKey="page:wellness-hotels" />
  </div>
</BaseLayout>
