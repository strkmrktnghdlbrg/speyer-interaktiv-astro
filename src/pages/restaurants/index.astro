---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RestaurantCard from "../../components/RestaurantCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { restaurants } from "../../data/restaurants";
import { city } from "../../data/city";

const all = [...restaurants].sort((a, b) => a.name.localeCompare(b.name, "de"));
const cuisines = Array.from(new Set(restaurants.map((r) => r.cuisine))).sort();
---

<BaseLayout
  title={`Restaurants in ${city.name}`}
  description={`Pfälzer Küche, Weinstuben, Brauhäuser, Sterne-Küche, italienische Trattorien und kreative Bistros in allen Stadtteilen von ${city.name}.`}
>
  <div class="container-page py-10">
    <Breadcrumbs items={[{ label: city.name, href: "/" }, { label: "Restaurants" }]} />

    <div class="max-w-3xl mb-10">
      <p class="eyebrow mb-2">Essen gehen</p>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4" style="color: var(--color-deep-plum);">
        Restaurants in {city.name}
      </h1>
      <p class="text-lg leading-relaxed" style="color: var(--color-shadow-graphite);">
        Pfälzer Weinstuben, Brauhäuser, türkische Mezze, italienische Trattorien
        und kreative Bistros in der Altstadt. {all.length} Adressen sortiert von A bis Z.
      </p>
    </div>

    <div class="flex flex-wrap gap-2 mb-10">
      {cuisines.map((c) => (
        <span class="pill">{c}</span>
      ))}
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {all.map((r) => <RestaurantCard restaurant={r} />)}
    </div>
  </div>
</BaseLayout>
