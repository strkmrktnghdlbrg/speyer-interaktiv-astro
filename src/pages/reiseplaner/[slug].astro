---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentImage from "../../components/ContentImage.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import GetYourGuideWidget from "../../components/GetYourGuideWidget.astro";
import Stay22TopHotels from "../../components/Stay22TopHotels.astro";
import { guides, getGuide, type SlotType } from "../../data/guides";
import { getSight } from "../../data/sights";
import { getHotel } from "../../data/hotels";
import { getRestaurant } from "../../data/restaurants";
import { getDistrict } from "../../data/districts";
import { city } from "../../data/city";
import { affiliate } from "../../data/affiliate";
import { guidesEn } from "../../i18n/en/guides";

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const guide = getGuide(slug!)!;

const slotTypeLabels: Record<SlotType, string> = {
  morgens: "Morgens",
  mittagessen: "Mittagessen",
  nachmittag: "Nachmittag",
  abendessen: "Abendessen",
  abends: "Abends",
  uebernachten: "Übernachten",
};

const slotTypeColors: Record<SlotType, string> = {
  morgens: "var(--color-accent-tint)",
  mittagessen: "#fef3c7",
  nachmittag: "#dbeafe",
  abendessen: "#fce7f3",
  abends: "#e0e7ff",
  uebernachten: "var(--color-porcelain-mist)",
};

// Schema.org Article
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.title,
  description: guide.shortDesc,
  author: {
    "@type": "Organization",
    name: `${city.name}-Interaktiv`,
  },
  publisher: {
    "@type": "Organization",
    name: `${city.name}-Interaktiv`,
  },
  about: {
    "@type": "City",
    name: city.name,
  },
};
---

<BaseLayout title={guide.title} description={guide.shortDesc} alternateUrls={guidesEn[guide.slug] ? { de: `/reiseplaner/${guide.slug}/`, en: `/en/travel-planner/${guidesEn[guide.slug].slug}/` } : undefined}>
  <article>
    <div class="aspect-[4/3] sm:aspect-[16/9] relative max-h-[70vh] overflow-hidden">
      <ContentImage
        imgKey={guide.imageKey}
        fallbackHue={guide.imageHue}
        fallbackLabel={guide.title}
        showCredit
        loading="eager"
        imgClass="w-full h-full object-cover"
      />
    </div>

    <div class="container-page py-10">
      <Breadcrumbs
        items={[
          { label: city.name, href: "/" },
          { label: "Reiseplaner", href: "/reiseplaner/" },
          { label: guide.title },
        ]}
      />

      <div class="max-w-3xl mb-12">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="pill-accent">{guide.duration} Tage</span>
          <span class="pill">{guide.audience}</span>
          {guide.bestSeason && <span class="pill">Beste Zeit: {guide.bestSeason}</span>}
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-balance mb-4" style="color: var(--color-deep-plum);">
          {guide.title}
        </h1>
        <p class="text-xl leading-relaxed" style="color: var(--color-shadow-graphite);">
          {guide.lead}
        </p>
      </div>

      <nav class="mb-12 p-5 rounded-2xl" style="background: var(--color-porcelain-mist); border: 1px solid var(--color-lavender-ash);">
        <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--color-accent);">
          Inhaltsverzeichnis
        </p>
        <ol class="space-y-1.5">
          {guide.days.map((d) => (
            <li>
              <a
                href={`#tag-${d.number}`}
                class="text-sm font-semibold hover:underline"
                style="color: var(--color-inkwell-purple); text-underline-offset: 3px;"
              >
                <span style="color: var(--color-accent);">Tag {d.number}</span>
                {" - "}
                {d.title.replace(/^Tag \d+ - /, "")}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      {guide.days.map((day) => (
        <section id={`tag-${day.number}`} class="mb-16 scroll-mt-24">
          <div class="mb-8">
            <p class="text-sm font-bold uppercase tracking-widest mb-2" style="color: var(--color-accent);">
              Tag {day.number}
            </p>
            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4" style="color: var(--color-deep-plum);">
              {day.title.replace(/^Tag \d+ - /, "")}
            </h2>
            <p class="text-lg leading-relaxed max-w-3xl" style="color: var(--color-shadow-graphite);">
              {day.intro}
            </p>
          </div>

          <ol class="space-y-6">
            {day.slots.map((slot) => {
              const sight = slot.sightSlug ? getSight(slot.sightSlug) : null;
              const restaurant = slot.restaurantSlug ? getRestaurant(slot.restaurantSlug) : null;
              const hotel = slot.hotelSlug ? getHotel(slot.hotelSlug) : null;
              const district = slot.districtSlug ? getDistrict(slot.districtSlug) : null;
              return (
                <li class="grid grid-cols-[auto_1fr] gap-4 sm:gap-6">
                  <div class="text-right pt-1">
                    <p class="text-xs font-bold whitespace-nowrap" style="color: var(--color-accent);">
                      {slot.time.split(" – ")[0]}
                    </p>
                    {slot.time.includes("–") && (
                      <p class="text-[10px]" style="color: var(--color-slate-steel);">
                        bis {slot.time.split(" – ")[1]}
                      </p>
                    )}
                  </div>
                  <div
                    class="rounded-2xl p-5 sm:p-6"
                    style={`background: ${slotTypeColors[slot.type]}; border: 1px solid var(--color-lavender-ash);`}
                  >
                    <p class="text-[10px] font-bold uppercase tracking-widest mb-2" style="color: var(--color-shadow-graphite);">
                      {slotTypeLabels[slot.type]}
                    </p>
                    <h3 class="text-lg sm:text-xl font-bold mb-2" style="color: var(--color-deep-plum);">
                      {slot.title}
                    </h3>
                    <p class="text-sm sm:text-base leading-relaxed mb-3" style="color: var(--color-inkwell-purple);">
                      {slot.description}
                    </p>
                    <div class="flex flex-wrap gap-2 mb-3">
                      {sight && (
                        <a href={`/sehenswuerdigkeiten/${sight.slug}/`} class="pill-accent hover:underline">
                          {sight.name} →
                        </a>
                      )}
                      {restaurant && (
                        <a href={`/restaurants/${restaurant.slug}/`} class="pill-accent hover:underline">
                          {restaurant.name} →
                        </a>
                      )}
                      {hotel && (
                        <a href={`/hotels/${hotel.slug}/`} class="pill-accent hover:underline">
                          {hotel.name} →
                        </a>
                      )}
                      {district && !sight && !restaurant && (
                        <a href={`/stadtteile/${district.slug}/`} class="pill hover:underline">
                          Stadtteil: {district.name}
                        </a>
                      )}
                    </div>
                    {slot.tip && (
                      <p class="text-xs leading-relaxed mt-3 pt-3 border-t border-[var(--color-lavender-ash)]" style="color: var(--color-shadow-graphite);">
                        <strong style="color: var(--color-accent);">Tipp:</strong> {slot.tip}
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>

          {day.number === 1 && (
            <GetYourGuideWidget
              mode="city"
              cityQuery={affiliate.getYourGuide.cityQuery}
              numberOfItems={3}
              cmp={`reiseplaner-${guide.slug}-tag1`}
              title="Passende Touren für deinen ersten Tag"
              lead="Klassische Highlights direkt zum Buchen, falls du das ganze ohne eigene Recherche willst."
            />
          )}
          {day.number === 2 && (
            <GetYourGuideWidget
              mode="activities"
              q={`${city.name} Tour`}
              numberOfItems={3}
              cmp={`reiseplaner-${guide.slug}-tag2`}
              title="Geführte Touren rund um Tag 2"
              lead="Kuratierte Touren passend zum Schwerpunkt dieses Tages."
            />
          )}
        </section>
      ))}

      <Stay22TopHotels
        title={`Aktuell verfügbare Hotels in ${city.name}`}
        lead="Live-Preise und Bewertungen für deine Wunschnacht. Direktbuchung via Booking.com."
        limit={8}
      />
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>
