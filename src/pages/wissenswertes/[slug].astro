---
import BlogArticle from "../../layouts/BlogArticle.astro";
import ContentImage from "../../components/ContentImage.astro";
import GetYourGuideWidget from "../../components/GetYourGuideWidget.astro";
import { wissenswertes, getWissen } from "../../data/wissenswertes";
import { getEntry, render } from "astro:content";
import { city } from "../../data/city";

export function getStaticPaths() {
  return wissenswertes.map((w) => ({ params: { slug: w.slug } }));
}

const { slug } = Astro.params;
const item = getWissen(slug!)!;
const entry = await getEntry("wissenswertes", slug!);
const Content = entry ? (await render(entry)).Content : null;

// Sibling articles: same categories first, then any others — max 3
const sameCat = wissenswertes.filter(
  (w) =>
    w.slug !== item.slug &&
    item.categories.length > 0 &&
    w.categories.some((c) => item.categories.includes(c))
);
const others = wissenswertes.filter(
  (w) => w.slug !== item.slug && !sameCat.includes(w)
);
const siblings = [...sameCat, ...others].slice(0, 3);
---

<BlogArticle
  title={item.title}
  lead={item.lead}
  description={item.shortDesc}
  category="Wissenswertes"
  publishedAt={item.publishedAt}
  breadcrumbItems={[
    { label: city.name, href: "/" },
    { label: "Wissenswertes", href: "/wissenswertes/" },
    { label: item.title },
  ]}
>
  {item.imageKey && (
    <div class="not-prose mb-8 rounded-2xl overflow-hidden aspect-[16/9] relative">
      <ContentImage
        kind="article"
        imgKey={item.imageKey}
        fallbackHue={item.imageHue}
        fallbackLabel={item.title}
        loading="eager"
        sizes="(min-width: 1024px) 48rem, 100vw"
        widths={[640, 1024, 1536]}
      />
    </div>
  )}
  {Content ? <Content /> : (
    <>
      <p class="text-ink-700 leading-relaxed">{item.lead}</p>
      {item.legacyWpUrl && (
        <p class="mt-6 text-sm text-ink-500 italic">
          Der ausführliche Artikel wird derzeit migriert. Original:
          <a href={item.legacyWpUrl} rel="nofollow noopener" target="_blank" class="underline hover:text-[var(--color-accent)]">
            {item.legacyWpUrl}
          </a>
        </p>
      )}
    </>
  )}

  <GetYourGuideWidget offerKey={`article:${item.slug}`} />

  {siblings.length > 0 && (
    <div class="related-block">
      <h3>Mehr aus Wissenswertes</h3>
      <ul class="space-y-2 mt-3">
        {siblings.map((s) => (
          <li>
            <a href={`/wissenswertes/${s.slug}/`} class="font-semibold hover:underline" style="color: var(--color-accent); text-underline-offset: 3px;">
              {s.title}
            </a>
            <p class="text-sm mt-0.5" style="color: var(--color-shadow-graphite);">{s.shortDesc}</p>
          </li>
        ))}
      </ul>
      <a href="/wissenswertes/" class="inline-block mt-4 text-sm font-semibold hover:underline" style="color: var(--color-inkwell-purple); text-underline-offset: 3px;">
        Alle Wissenswertes-Artikel anzeigen &rarr;
      </a>
    </div>
  )}
</BlogArticle>
