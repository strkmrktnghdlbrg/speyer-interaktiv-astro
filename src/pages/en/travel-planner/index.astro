---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentImage from "../../../components/ContentImage.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import GetYourGuideWidget from "../../../components/GetYourGuideWidget.astro";
import { guides } from "../../../data/guides";
import { guidesEn } from "../../../i18n/en/guides";
import { city } from "../../../data/city";
import { t, tf } from "../../../i18n/ui";
import { homeUrl, indexUrl, detailUrl } from "../../../i18n/config";

const locale = "en";
---

<BaseLayout
  title={`Travel planner for ${city.name}`}
  description={tf(locale, "guides.metaDescription", { site: city.name })}
  locale={locale}
  alternateUrls={{ de: indexUrl("guides", "de"), en: indexUrl("guides", "en") }}
>
  <div class="container-page py-10">
    <Breadcrumbs locale={locale} items={[{ label: city.name, href: homeUrl(locale) }, { label: t(locale, "nav.guides") }]} />

    <div class="max-w-3xl mb-10">
      <p class="eyebrow mb-2">{t(locale, "guides.eyebrow")}</p>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4" style="color: var(--color-deep-plum);">
        {tf(locale, "guides.heading", { site: city.name })}
      </h1>
      <p class="text-lg leading-relaxed" style="color: var(--color-shadow-graphite);">
        {t(locale, "guides.intro")}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {guides.map((g) => {
        const en = guidesEn[g.slug];
        return (
          <a href={detailUrl("guides", en.slug, locale)} class="card group block overflow-hidden">
            <div class="aspect-[4/3] sm:aspect-[16/9] relative overflow-hidden">
              <ContentImage
                imgKey={g.imageKey}
                fallbackHue={g.imageHue}
                fallbackLabel={en.title}
                imgClass="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-4 left-4 flex flex-wrap gap-2">
                <span class="pill-accent">{tf(locale, "guides.days", { n: g.duration })}</span>
                <span class="pill bg-white/95 backdrop-blur-sm">{en.audience}</span>
              </div>
            </div>
            <div class="p-6">
              <h2 class="text-2xl font-bold tracking-tight mb-3 group-hover:text-[var(--color-accent)] transition-colors" style="color: var(--color-deep-plum);">
                {en.title}
              </h2>
              <p class="text-base leading-relaxed" style="color: var(--color-shadow-graphite);">
                {en.shortDesc}
              </p>
              {en.bestSeason && (
                <p class="mt-4 text-xs font-semibold" style="color: var(--color-slate-steel);">
                  {t(locale, "guides.bestSeason")} <span style="color: var(--color-inkwell-purple);">{en.bestSeason}</span>
                </p>
              )}
            </div>
          </a>
        );
      })}
    </div>

    <GetYourGuideWidget
      locale={locale}
      offerKey="page:reiseplaner"
      title="Ready-to-book tours for your trip"
      lead="Classic highlights you can book right away - free cancellation on most options."
    />
  </div>
</BaseLayout>
