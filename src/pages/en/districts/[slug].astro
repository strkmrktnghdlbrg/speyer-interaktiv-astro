---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentImage from "../../../components/ContentImage.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SightCard from "../../../components/SightCard.astro";
import HotelCard from "../../../components/HotelCard.astro";
import RestaurantCard from "../../../components/RestaurantCard.astro";
import DistrictCard from "../../../components/DistrictCard.astro";
import Stay22NearbyHotels from "../../../components/Stay22NearbyHotels.astro";
import GetYourGuideWidget from "../../../components/GetYourGuideWidget.astro";
import { districts } from "../../../data/districts";
import { districtsEn } from "../../../i18n/en/districts";
import { sightsByDistrict } from "../../../data/sights";
import { topHotelsByDistrict } from "../../../data/hotels";
import { restaurantsByDistrict } from "../../../data/restaurants";
import { city } from "../../../data/city";
import { t, tf } from "../../../i18n/ui";
import { homeUrl, indexUrl, detailUrl } from "../../../i18n/config";

export function getStaticPaths() {
  return districts.map((d) => ({ params: { slug: districtsEn[d.slug].slug }, props: { district: d, en: districtsEn[d.slug] } }));
}

const { district, en } = Astro.props;
const locale = "en";
const sights = sightsByDistrict(district.slug);
const hotels = topHotelsByDistrict(district.slug, 8);
const restaurants = restaurantsByDistrict(district.slug).slice(0, 8);
const otherDistricts = districts.filter((d) => d.slug !== district.slug).slice(0, 4);

const schema = {
  "@context": "https://schema.org",
  "@type": "Place",
  name: `${en.name} in ${city.name}`,
  description: en.longDesc,
  containedInPlace: { "@type": "City", name: city.name },
  geo: { "@type": "GeoCoordinates", latitude: district.coordinates[0], longitude: district.coordinates[1] },
};
---

<BaseLayout
  title={tf(locale, "districts.detailHeading", { name: en.name, site: city.name })}
  description={en.shortDesc}
  locale={locale}
  alternateUrls={{ de: `/stadtteile/${district.slug}/`, en: detailUrl("districts", en.slug, locale) }}
>
  <div class="aspect-[4/3] sm:aspect-[16/9] relative max-h-[70vh] overflow-hidden">
    <ContentImage
      kind="district"
      imgKey={district.imageKey}
      fallbackHue={district.hue}
      fallbackLabel={en.name}
      loading="eager"
      imgClass="w-full h-full object-cover"
    />
  </div>

  <div class="container-page py-10">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: city.name, href: homeUrl(locale) },
        { label: t(locale, "nav.districts"), href: indexUrl("districts", locale) },
        { label: en.name },
      ]}
    />

    <div class="max-w-3xl mb-12">
      <div class="flex flex-wrap gap-2 mb-4">
        {en.characterTags.map((tag) => <span class="pill">{tag}</span>)}
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-balance mb-4" style="color: var(--color-deep-plum);">
        {en.name}
      </h1>
      <p class="text-xl leading-relaxed mb-6" style="color: var(--color-shadow-graphite);">
        {en.shortDesc}
      </p>
      <div class="prose-content max-w-none text-base leading-relaxed" style="color: var(--color-inkwell-purple);">
        <p>{en.longDesc}</p>
      </div>
    </div>

    {sights.length > 0 && (
      <section class="mb-16">
        <div class="flex items-end justify-between mb-6">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight" style="color: var(--color-deep-plum);">
            {tf(locale, "related.sightsIn", { name: en.name })}
          </h2>
          <a href={indexUrl("sights", locale)} class="link-accent font-semibold text-sm hidden sm:inline-flex">
            {t(locale, "related.allSights")}
          </a>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {sights.map((s) => <SightCard sight={s} locale={locale} />)}
        </div>
      </section>
    )}

    {hotels.length > 0 && (
      <section class="mb-16 -mx-4 sm:-mx-6 px-4 sm:px-8 py-10 rounded-3xl" style="background: var(--color-porcelain-mist);">
        <div class="flex items-end justify-between mb-6">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight" style="color: var(--color-deep-plum);">
            {tf(locale, "related.hotelsIn", { name: en.name })}
          </h2>
          <a href={indexUrl("hotels", locale)} class="link-accent font-semibold text-sm hidden sm:inline-flex">
            {t(locale, "related.allHotels")}
          </a>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {hotels.map((h) => <HotelCard hotel={h} locale={locale} />)}
        </div>
      </section>
    )}

    <Stay22NearbyHotels
      locale={locale}
      lat={district.coordinates[0]}
      lng={district.coordinates[1]}
      near={en.name}
      radius={2000}
      limit={4}
    />

    <GetYourGuideWidget locale={locale} offerKey={`district:${district.slug}`} />

    {restaurants.length > 0 && (
      <section class="mb-16">
        <div class="flex items-end justify-between mb-6">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight" style="color: var(--color-deep-plum);">
            {tf(locale, "related.restaurantsInDistrict", { name: en.name })}
          </h2>
          <a href={indexUrl("restaurants", locale)} class="link-accent font-semibold text-sm hidden sm:inline-flex">
            {t(locale, "related.allRestaurants")}
          </a>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {restaurants.map((r) => <RestaurantCard restaurant={r} locale={locale} />)}
        </div>
      </section>
    )}

    <section>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-6" style="color: var(--color-deep-plum);">
        {t(locale, "related.otherDistricts")}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {otherDistricts.map((d) => <DistrictCard district={d} locale={locale} />)}
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>
