---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ContentImage from "../../../components/ContentImage.astro";
import GetYourGuideWidget from "../../../components/GetYourGuideWidget.astro";
import { wissenswertes } from "../../../data/wissenswertes";
import { wissenEn } from "../../../i18n/en/wissenswertes";
import { city } from "../../../data/city";
import { t } from "../../../i18n/ui";
import { homeUrl, indexUrl, detailUrl } from "../../../i18n/config";

const locale = "en";

// Nur Artikel mit englischer Fassung (der bezahlte Gastartikel bleibt DE-only).
const items = wissenswertes.filter((w) => wissenEn[w.slug]);

const title = `Good to Know: ${city.name}`;
const description = `Background articles on the history and culture of ${city.name}: from the Roman camp and the Salian emperors to the UNESCO World Heritage.`;

// Epochen-Zeitleiste, gespiegelt von /wissenswertes/.
const epochs = [
  {
    span: "c. 10 AD",
    title: "Roman beginnings",
    text: "The settlement history on the Rhine begins with the military camp of Noviomagus.",
    href: detailUrl("wissen", wissenEn["roemisches-speyer"].slug, locale),
  },
  {
    span: "11th c.",
    title: "Age of the Salians",
    text: "Emperor Conrad II lays the foundation stone of the cathedral, the Salian burial place.",
    href: detailUrl("wissen", wissenEn["salier"].slug, locale),
  },
  {
    span: "Middle Ages",
    title: "Free imperial city",
    text: "A bishop's see, imperial diets and a center of imperial politics.",
    href: detailUrl("wissen", wissenEn["mittelalterliches-speyer"].slug, locale),
  },
  {
    span: "1529",
    title: "The Protestation",
    text: "The Protestation of Speyer gives Protestantism its name.",
    href: detailUrl("wissen", wissenEn["reformation"].slug, locale),
  },
  {
    span: "since 1981",
    title: "UNESCO World Heritage",
    text: "The Imperial Cathedral is part of the heritage of humanity.",
    href: detailUrl("wissen", wissenEn["kulturerbe"].slug, locale),
  },
];

const enLink = (deSlug: string) => detailUrl("wissen", wissenEn[deSlug].slug, locale);
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  alternateUrls={{ de: indexUrl("wissen", "de"), en: indexUrl("wissen", "en") }}
>
  <div class="container-page py-10">
    <Breadcrumbs locale={locale} items={[
      { label: t(locale, "nav.home"), href: homeUrl(locale) },
      { label: t(locale, "nav.wissen") },
    ]} />

    <header class="max-w-3xl mb-10">
      <p class="eyebrow mb-2">History &amp; culture</p>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4" style="font-family: var(--font-display);">
        Good to Know: {city.name}
      </h1>
      <p class="text-lg text-ink-700 leading-relaxed">
        Few cities in Germany carry as much history in as small a space as
        {city.name}. Across {items.length} background articles we follow the
        traces of some two thousand years: from Roman Noviomagus through the
        imperial city of the Salians and the Protestation of the Reformation
        to today's cathedral city on the Rhine with its roughly
        {city.population.toLocaleString("en-US")} inhabitants.
      </p>
    </header>

    <section class="max-w-3xl mb-12 space-y-4 text-ink-700 leading-relaxed">
      <p>
        It begins with the water: its favorable position on the Rhine made
        {city.name} a hub for trade and administration as early as Roman
        times. How the camp <a href={enLink("roemisches-speyer")} class="underline decoration-[var(--color-accent)] underline-offset-2 hover:text-[var(--color-accent)]">Noviomagus became a Roman civitas</a>,
        and what testimony of that era still lies in the ground, is told by the
        <a href={enLink("archaeologische-funde")} class="underline decoration-[var(--color-accent)] underline-offset-2 hover:text-[var(--color-accent)]">archaeological finds</a>
        from across the city.
      </p>
      <p>
        In the Middle Ages, {city.name} steps onto the European stage. Under
        the <a href={enLink("salier")} class="underline decoration-[var(--color-accent)] underline-offset-2 hover:text-[var(--color-accent)]">Salians</a>,
        the cathedral rises as the largest surviving Romanesque church in the
        world, and the <a href={enLink("mittelalterliches-speyer")} class="underline decoration-[var(--color-accent)] underline-offset-2 hover:text-[var(--color-accent)]">free imperial city</a>
        hosts major imperial diets. In 1529 the Protestant estates formulate
        the <a href={enLink("reformation")} class="underline decoration-[var(--color-accent)] underline-offset-2 hover:text-[var(--color-accent)]">Protestation of Speyer</a>
        here, giving Protestantism its name. War and destruction, as in the
        <a href={enLink("dreissigjaehriger-krieg")} class="underline decoration-[var(--color-accent)] underline-offset-2 hover:text-[var(--color-accent)]">Thirty Years' War</a>,
        belong to this history as much as the dark chapters of the
        <a href={enLink("hexenverfolgung")} class="underline decoration-[var(--color-accent)] underline-offset-2 hover:text-[var(--color-accent)]">witch trials</a>.
      </p>
      <p>
        What remains is a built memory: since 1981 the Imperial Cathedral has
        been part of the
        <a href={enLink("kulturerbe")} class="underline decoration-[var(--color-accent)] underline-offset-2 hover:text-[var(--color-accent)]">UNESCO World Heritage</a>,
        and the city's
        <a href={enLink("baukunst")} class="underline decoration-[var(--color-accent)] underline-offset-2 hover:text-[var(--color-accent)]">architecture</a>
        tells every era along the way. To see the places themselves, head to
        the <a href={indexUrl("sights", locale)} class="underline decoration-[var(--color-accent)] underline-offset-2 hover:text-[var(--color-accent)]">attractions</a>.
      </p>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold mb-6" style="font-family: var(--font-display);">
        Speyer in five eras
      </h2>
      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {epochs.map((e) => (
          <li>
            <a
              href={e.href}
              class="group flex h-full flex-col rounded-2xl border border-ink-100 bg-white p-5 transition-all hover:border-[var(--color-accent)] hover:shadow-lg"
            >
              <span class="text-xs font-semibold uppercase tracking-wide text-[var(--color-accent)] mb-1">
                {e.span}
              </span>
              <span class="text-base font-bold mb-2 group-hover:text-[var(--color-accent)] transition-colors" style="font-family: var(--font-display);">
                {e.title}
              </span>
              <span class="text-sm text-ink-700 leading-relaxed">{e.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2 class="text-2xl font-bold mb-6" style="font-family: var(--font-display);">
        All background articles
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map((w) => (
          <a
            href={detailUrl("wissen", wissenEn[w.slug].slug, locale)}
            class="group block rounded-2xl border border-ink-100 bg-white overflow-hidden transition-all hover:border-[var(--color-accent)] hover:shadow-lg"
          >
            <div class="aspect-[4/3] relative overflow-hidden">
              <ContentImage
                kind="article"
                imgKey={w.imageKey}
                fallbackHue={w.imageHue}
                fallbackLabel={wissenEn[w.slug].title}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              />
            </div>
            <div class="p-5">
              <h3 class="text-lg font-bold mb-2 group-hover:text-[var(--color-accent)] transition-colors" style="font-family: var(--font-display);">
                {wissenEn[w.slug].title}
              </h3>
              <p class="text-sm text-ink-700 leading-relaxed line-clamp-3">
                {wissenEn[w.slug].shortDesc}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <GetYourGuideWidget locale={locale} offerKey="page:wissenswertes" />
  </div>
</BaseLayout>
