---
/**
 * /werben/newsletter/ — Werbeform "Newsletter".
 * Der Newsletter-Kanal existiert noch nicht → ehrlich als
 * "im Aufbau" gekennzeichnet, Interessenten werden vorgemerkt.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { city } from "../../data/city";

const faqs = [
  {
    q: "Wann startet der Newsletter?",
    a: "Der Kanal befindet sich derzeit im Aufbau. Sobald er startet, informieren wir alle vorgemerkten Unternehmen zuerst.",
  },
  {
    q: "Was kostet eine Newsletter-Erwähnung?",
    a: "Preise legen wir zum Start des Kanals fest. Premium-Partner erhalten ihre Erwähnung im Rahmen ihres Pakets. Alle Angebote richten sich ausschließlich an Unternehmer (B2B).",
  },
  {
    q: "Kann ich mich schon jetzt vormerken lassen?",
    a: "Ja - schreib uns über die Kontaktseite, dann melden wir uns, sobald der Newsletter live geht.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Newsletter-Werbung"
  description={`Newsletter-Werbung auf ${city.name}-Interaktiv: Der Kanal ist im Aufbau - Unternehmen können sich jetzt vormerken lassen. B2B.`}
>
  <section
    class="relative overflow-hidden py-16 sm:py-20"
    style="background: linear-gradient(120deg, var(--color-deep-plum) 0%, var(--color-accent) 100%);"
  >
    <div class="container-page relative">
      <Breadcrumbs items={[{ label: city.name, href: "/" }, { label: "Werben", href: "/werben/" }, { label: "Newsletter" }]} />
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-widest text-white/80 mb-4">
          Newsletter · im Aufbau
        </p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-white text-balance leading-[1.05]">
          Der {city.name}-Interaktiv Newsletter entsteht gerade.
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-white/85 max-w-2xl">
          Wir bauen den Newsletter derzeit auf und versprechen nichts, was es
          noch nicht gibt: Sobald der Kanal startet, können Unternehmen dort
          mit einer Erwähnung sichtbar werden. Merke dich unverbindlich vor.
        </p>
        <div class="mt-8">
          <a href="/kontakt/" class="inline-flex items-center rounded-full px-6 py-3 text-sm font-bold bg-white hover:bg-white/90 transition-colors" style="color: var(--color-deep-plum);">
            Unverbindlich vormerken
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <p class="eyebrow mb-2">Häufige Fragen</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight" style="color: var(--color-deep-plum);">
          Gut zu wissen
        </h2>
      </div>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="card p-5">
            <summary class="font-semibold cursor-pointer" style="color: var(--color-deep-plum);">{f.q}</summary>
            <p class="mt-3 text-sm leading-relaxed" style="color: var(--color-shadow-graphite);">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page pb-20">
    <div class="rounded-3xl px-8 py-12 text-center" style="background: var(--color-porcelain-mist);">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-balance mb-4" style="color: var(--color-deep-plum);">
        Sofort sichtbar werden? Das geht schon heute.
      </h2>
      <p class="max-w-xl mx-auto mb-8 text-sm leading-relaxed" style="color: var(--color-shadow-graphite);">
        Mit dem Premium-Partner-Eintrag im Branchenverzeichnis bist du ab
        sofort präsent - die Newsletter-Erwähnung ist dort enthalten, sobald
        der Kanal startet.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/werben/premium-partner/" class="btn-primary">Premium-Partner ansehen</a>
        <a href="/kontakt/" class="btn-outline">Kontakt aufnehmen</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
