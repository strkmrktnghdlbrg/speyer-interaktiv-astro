---
/**
 * /werben/ — Werbe-Hub (Inquiry-Funnel, keine Selbstbuchung).
 * Preise nur auf der Premium-Partner-Seite; alle CTAs → /kontakt/.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { city } from "../../data/city";

const werbeformen = [
  {
    title: "Premium-Partner",
    desc: `Hervorgehobener Eintrag im Branchenverzeichnis mit Logo, Beschreibung, Website-Link und Verlinkung aus passenden Ratgebern.`,
    href: "/werben/premium-partner/",
    linkLabel: "Premium-Partner ansehen",
  },
  {
    title: "Gesponserte Artikel",
    desc: `Ein redaktioneller Beitrag über dein Unternehmen - dauerhaft online, mit dofollow-Verlinkung auf deine Website.`,
    href: "/werben/gesponserte-artikel/",
    linkLabel: "Mehr zu Artikeln",
  },
  {
    title: "Newsletter",
    desc: `Erwähnung im ${city.name}-Interaktiv Newsletter - der Kanal befindet sich derzeit im Aufbau.`,
    href: "/werben/newsletter/",
    linkLabel: "Mehr zum Newsletter",
  },
];

const steps = [
  {
    title: "Anfragen",
    desc: "Schick uns über die Kontaktseite kurz, wer du bist und was du erreichen willst.",
  },
  {
    title: "Angebot erhalten",
    desc: "Wir melden uns mit einem konkreten Vorschlag samt Preis - ohne versteckte Kosten.",
  },
  {
    title: "Live gehen",
    desc: "Nach Freigabe setzen wir deinen Auftritt um. Änderungswünsche klären wir direkt mit dir.",
  },
];

const faqs = [
  {
    q: "Für wen ist Werbung auf dem Portal geeignet?",
    a: `Für Unternehmen mit Bezug zu ${city.name} und Umgebung: Gastronomie, Hotellerie, Handel, Handwerk und Dienstleister, die lokal gefunden werden wollen. Alle Angebote richten sich ausschließlich an Unternehmer (B2B).`,
  },
  {
    q: "Wie schnell ist mein Auftritt online?",
    a: "Nach Beauftragung und Freigabe der Inhalte in der Regel innerhalb weniger Werktage.",
  },
  {
    q: "Gibt es Laufzeiten oder automatische Verlängerungen?",
    a: "Nein. Der Premium-Partner-Eintrag läuft ein Jahr und verlängert sich nicht automatisch. Rechtzeitig vor Ablauf melden wir uns.",
  },
  {
    q: "Kann ich zuerst kostenlos gelistet werden?",
    a: "Ja. Im Branchenverzeichnis kannst du deinen Betrieb jederzeit kostenlos eintragen lassen - Premium ist optional.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title={`Werben auf ${city.name}-Interaktiv`}
  description={`Lokal sichtbar werden: Premium-Partner-Eintrag, gesponserte Artikel und mehr auf ${city.name}-Interaktiv. Angebote für Unternehmen (B2B).`}
>
  <section
    class="relative overflow-hidden py-16 sm:py-20"
    style="background: linear-gradient(120deg, var(--color-deep-plum) 0%, var(--color-accent) 100%);"
  >
    <div class="container-page relative">
      <Breadcrumbs items={[{ label: city.name, href: "/" }, { label: "Werben" }]} />
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-widest text-white/80 mb-4">
          Werben auf {city.name}-Interaktiv
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white text-balance leading-[1.05]">
          Lokal sichtbar werden - bei Menschen, die {city.name} lieben.
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-white/85 max-w-2xl">
          {city.name}-Interaktiv ist das Stadtportal für Gäste, Neuzugezogene und
          Einheimische. Erreiche genau die Menschen, die gerade nach {city.name} suchen.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/kontakt/" class="btn-primary">Unverbindlich anfragen</a>
          <a href="/branchenverzeichnis/" class="inline-flex items-center rounded-full px-5 py-2.5 text-sm font-semibold text-white border border-white/40 hover:bg-white/10 transition-colors">
            Zum Branchenverzeichnis
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <p class="eyebrow mb-2">Werbeformen</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight" style="color: var(--color-deep-plum);">
        Drei Wege zu mehr Sichtbarkeit
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 max-w-5xl mx-auto">
      {werbeformen.map((w) => (
        <a href={w.href} class="card p-6 block group">
          <h3 class="text-lg font-bold mb-2 group-hover:text-[var(--color-accent)] transition-colors" style="color: var(--color-deep-plum);">
            {w.title}
          </h3>
          <p class="text-sm leading-relaxed mb-4" style="color: var(--color-shadow-graphite);">
            {w.desc}
          </p>
          <span class="link-accent text-sm font-semibold">{w.linkLabel} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container-page py-16">
    <div class="rounded-3xl p-8 sm:p-12" style="background: var(--color-porcelain-mist);">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="eyebrow mb-2">So funktioniert's</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight" style="color: var(--color-deep-plum);">
          In drei Schritten zum Auftritt
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {steps.map((s, i) => (
          <div class="text-center">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-full text-white font-bold mb-4" style="background: var(--color-accent);">
              {i + 1}
            </span>
            <h3 class="font-bold mb-2" style="color: var(--color-deep-plum);">{s.title}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-shadow-graphite);">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <p class="eyebrow mb-2">Häufige Fragen</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight" style="color: var(--color-deep-plum);">
          Gut zu wissen
        </h2>
      </div>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="card p-5">
            <summary class="font-semibold cursor-pointer" style="color: var(--color-deep-plum);">{f.q}</summary>
            <p class="mt-3 text-sm leading-relaxed" style="color: var(--color-shadow-graphite);">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page pb-20">
    <div
      class="rounded-3xl px-8 py-12 text-center"
      style="background: linear-gradient(120deg, var(--color-deep-plum) 0%, var(--color-accent) 100%);"
    >
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white text-balance mb-4">
        Bereit, in {city.name} gefunden zu werden?
      </h2>
      <p class="text-white/85 max-w-xl mx-auto mb-8">
        Schreib uns, was du vorhast - wir melden uns mit einem konkreten Vorschlag.
      </p>
      <a href="/kontakt/" class="inline-flex items-center rounded-full px-6 py-3 text-sm font-bold bg-white hover:bg-white/90 transition-colors" style="color: var(--color-deep-plum);">
        Jetzt Kontakt aufnehmen
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
