---
/**
 * /werben/gesponserte-artikel/ — Werbeform "Gesponserter Artikel".
 * Inquiry-Funnel, Preis auf Anfrage; 1 redaktioneller Beitrag,
 * dauerhaft online, dofollow.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { city } from "../../data/city";

const vorteile = [
  {
    title: "Redaktionell aufbereitet",
    desc: "Wir schreiben den Beitrag im Stil des Portals - informativ, lokal verankert und auf dein Unternehmen zugeschnitten.",
  },
  {
    title: "Dauerhaft online",
    desc: "Der Artikel bleibt dauerhaft erreichbar und wird intern aus passenden Rubriken verlinkt.",
  },
  {
    title: "Dofollow-Verlinkung",
    desc: "Dein Unternehmen erhält einen direkten, suchmaschinenwirksamen Link auf die eigene Website.",
  },
];

const faqs = [
  {
    q: "Wie läuft die Erstellung ab?",
    a: "Du lieferst Stichpunkte, Material und Wünsche - wir erstellen einen Entwurf und stimmen ihn mit dir ab. Veröffentlicht wird erst nach deiner Freigabe.",
  },
  {
    q: "Wird der Beitrag als Werbung gekennzeichnet?",
    a: "Gesponserte Beiträge werden entsprechend den rechtlichen Vorgaben transparent gekennzeichnet.",
  },
  {
    q: "Was kostet ein gesponserter Artikel?",
    a: "Den aktuellen Preis nennen wir dir auf Anfrage über die Kontaktseite. Für Premium-Partner ist ein Artikel pro Jahr bereits enthalten. Alle Angebote richten sich ausschließlich an Unternehmer (B2B).",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Gesponserte Artikel"
  description={`Gesponserte Artikel auf ${city.name}-Interaktiv: redaktioneller Beitrag über dein Unternehmen, dauerhaft online, mit dofollow-Verlinkung. B2B.`}
>
  <section
    class="relative overflow-hidden py-16 sm:py-20"
    style="background: linear-gradient(120deg, var(--color-deep-plum) 0%, var(--color-accent) 100%);"
  >
    <div class="container-page relative">
      <Breadcrumbs items={[{ label: city.name, href: "/" }, { label: "Werben", href: "/werben/" }, { label: "Gesponserte Artikel" }]} />
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-widest text-white/80 mb-4">
          Gesponserte Artikel
        </p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-white text-balance leading-[1.05]">
          Deine Geschichte, erzählt im Stadtportal.
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-white/85 max-w-2xl">
          Ein redaktioneller Beitrag stellt dein Unternehmen ausführlich vor -
          dauerhaft online, intern verlinkt und mit dofollow-Link auf deine Website.
        </p>
        <div class="mt-8">
          <a href="/kontakt/" class="inline-flex items-center rounded-full px-6 py-3 text-sm font-bold bg-white hover:bg-white/90 transition-colors" style="color: var(--color-deep-plum);">
            Artikel anfragen
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 max-w-5xl mx-auto">
      {vorteile.map((v) => (
        <div class="card p-6">
          <h3 class="font-bold mb-2" style="color: var(--color-deep-plum);">{v.title}</h3>
          <p class="text-sm leading-relaxed" style="color: var(--color-shadow-graphite);">{v.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page pb-16">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <p class="eyebrow mb-2">Häufige Fragen</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight" style="color: var(--color-deep-plum);">
          Gut zu wissen
        </h2>
      </div>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="card p-5">
            <summary class="font-semibold cursor-pointer" style="color: var(--color-deep-plum);">{f.q}</summary>
            <p class="mt-3 text-sm leading-relaxed" style="color: var(--color-shadow-graphite);">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page pb-20">
    <div class="rounded-3xl px-8 py-12 text-center" style="background: var(--color-porcelain-mist);">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-balance mb-4" style="color: var(--color-deep-plum);">
        Tipp: Im Premium-Paket ist ein Artikel pro Jahr enthalten.
      </h2>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/werben/premium-partner/" class="btn-primary">Premium-Partner ansehen</a>
        <a href="/kontakt/" class="btn-outline">Direkt anfragen</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
