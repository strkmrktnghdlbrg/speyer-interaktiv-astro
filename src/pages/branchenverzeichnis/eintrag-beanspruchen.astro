---
/**
 * /branchenverzeichnis/eintrag-beanspruchen/ — Claim-Funnel.
 * Kostenloser Eintrag / Übernahme eines bestehenden Eintrags + Premium-Upsell.
 *
 * Formular-Handling: Kein Form-Endpoint im Projekt vorhanden → Formular
 * rendert nur mit PUBLIC_WEB3FORMS_KEY (siehe .env.example), sonst
 * obfuskierte E-Mail. Spam-Schutz: Honeypot; Turnstile ist TODO,
 * sobald ein Site-Key vorliegt.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ObfuscatedEmail from "../../components/ObfuscatedEmail.astro";
import { city } from "../../data/city";
import { legal } from "../../data/legal";
import { kategorien } from "../../data/branchenbuch";

// Web3Forms nimmt die Zuschrift entgegen. Der Access-Key ist oeffentlich, er
// steht im ausgelieferten Formular-HTML; per PUBLIC_WEB3FORMS_KEY pro Domain
// ueberschreibbar, falls die Zuschriften getrennt eingehen sollen.
const formKey = (import.meta.env.PUBLIC_WEB3FORMS_KEY ??
  "b65f4e95-6ac7-4003-a46a-fe4e08b120e2") as string | undefined;
const formEnabled = typeof formKey === "string" && formKey.length > 0;
---

<BaseLayout
  title="Eintrag beanspruchen"
  description={`Kostenlosen Eintrag im Branchenverzeichnis ${city.name} anlegen oder bestehenden Eintrag übernehmen und korrigieren.`}
>
  <section
    class="relative overflow-hidden py-16 sm:py-20"
    style="background: linear-gradient(120deg, var(--color-deep-plum) 0%, var(--color-accent) 100%);"
  >
    <div class="container-page relative">
      <Breadcrumbs
        items={[
          { label: city.name, href: "/" },
          { label: "Branchenverzeichnis", href: "/branchenverzeichnis/" },
          { label: "Eintrag beanspruchen" },
        ]}
      />
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-widest text-white/80 mb-4">
          Kostenloser Eintrag
        </p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-white text-balance leading-[1.05]">
          Dein Betrieb gehört ins {city.name}er Branchenverzeichnis.
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-white/85 max-w-2xl">
          Neu eintragen oder einen bestehenden Eintrag übernehmen und
          korrigieren - beides ist kostenlos.
        </p>
      </div>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      <div class="card p-6">
        <h2 class="text-lg font-bold mb-3" style="color: var(--color-deep-plum);">Kostenloser Eintrag</h2>
        <ul class="space-y-2 text-sm" style="color: var(--color-inkwell-purple);">
          <li class="flex items-start gap-2"><span style="color: var(--color-accent);" class="font-bold">✓</span> Name, Adresse, Kategorie</li>
          <li class="flex items-start gap-2"><span style="color: var(--color-accent);" class="font-bold">✓</span> Alphabetische Listung in deiner Kategorie</li>
          <li class="flex items-start gap-2"><span style="color: var(--color-accent);" class="font-bold">✓</span> Dauerhaft sichtbar</li>
          <li class="flex items-start gap-2"><span style="color: var(--color-slate-steel);" class="font-bold">✕</span> Kein Logo, keine Beschreibung, kein Link</li>
        </ul>
      </div>
      <div class="rounded-2xl border-2 p-6" style="border-color: var(--color-accent);">
        <h2 class="text-lg font-bold mb-3 flex items-center gap-2" style="color: var(--color-deep-plum);">
          Premium-Partner
          <span class="text-[10px] font-bold uppercase tracking-wide rounded-full px-2 py-0.5 text-white" style="background: var(--color-accent);">★</span>
        </h2>
        <ul class="space-y-2 text-sm mb-4" style="color: var(--color-inkwell-purple);">
          <li class="flex items-start gap-2"><span style="color: var(--color-accent);" class="font-bold">✓</span> Ganz oben in der Kategorie, mit Logo und Beschreibung</li>
          <li class="flex items-start gap-2"><span style="color: var(--color-accent);" class="font-bold">✓</span> Website- & E-Mail-Button, dofollow</li>
          <li class="flex items-start gap-2"><span style="color: var(--color-accent);" class="font-bold">✓</span> 1 gesponserter Artikel pro Jahr</li>
        </ul>
        <a href="/werben/premium-partner/" class="link-accent text-sm font-semibold">Details & Preis →</a>
      </div>
    </div>
  </section>

  <section class="container-page pb-20">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl font-bold tracking-tight mb-6" style="color: var(--color-deep-plum);">
        Eintrag anlegen oder übernehmen
      </h2>

      {formEnabled ? (
        <form action="https://api.web3forms.com/submit" method="POST" class="card p-6 space-y-5">
          <input type="hidden" name="access_key" value={formKey} />
          <input type="hidden" name="subject" value={`Branchenverzeichnis-Eintrag über ${city.name}-interaktiv.de`} />
          <!-- Honeypot gegen Spam-Bots; Turnstile folgt, sobald ein Site-Key vorliegt -->
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" aria-hidden="true" />

          <div>
            <label for="be-name" class="block text-sm font-semibold mb-1.5" style="color: var(--color-inkwell-purple);">Name des Betriebs *</label>
            <input id="be-name" name="betrieb" type="text" required class="w-full rounded-xl border border-[var(--color-lavender-ash)] px-4 py-2.5 text-sm focus:outline-none focus:border-[var(--color-accent)]" />
          </div>
          <div>
            <label for="be-kategorie" class="block text-sm font-semibold mb-1.5" style="color: var(--color-inkwell-purple);">Kategorie *</label>
            <select id="be-kategorie" name="kategorie" required class="w-full rounded-xl border border-[var(--color-lavender-ash)] px-4 py-2.5 text-sm bg-white focus:outline-none focus:border-[var(--color-accent)]">
              <option value="">Bitte wählen</option>
              {kategorien.map((k) => (
                <option value={k.slug}>{k.name}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="be-adresse" class="block text-sm font-semibold mb-1.5" style="color: var(--color-inkwell-purple);">Adresse *</label>
            <input id="be-adresse" name="adresse" type="text" required placeholder={`Straße Hausnummer, PLZ ${city.name}`} class="w-full rounded-xl border border-[var(--color-lavender-ash)] px-4 py-2.5 text-sm focus:outline-none focus:border-[var(--color-accent)]" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="be-telefon" class="block text-sm font-semibold mb-1.5" style="color: var(--color-inkwell-purple);">Telefon</label>
              <input id="be-telefon" name="telefon" type="tel" placeholder="06232 ..." class="w-full rounded-xl border border-[var(--color-lavender-ash)] px-4 py-2.5 text-sm focus:outline-none focus:border-[var(--color-accent)]" />
            </div>
            <div>
              <label for="be-website" class="block text-sm font-semibold mb-1.5" style="color: var(--color-inkwell-purple);">Website</label>
              <input id="be-website" name="website" type="url" placeholder="https://..." class="w-full rounded-xl border border-[var(--color-lavender-ash)] px-4 py-2.5 text-sm focus:outline-none focus:border-[var(--color-accent)]" />
            </div>
          </div>
          <div>
            <label for="be-email" class="block text-sm font-semibold mb-1.5" style="color: var(--color-inkwell-purple);">E-Mail für Rückfragen *</label>
            <input id="be-email" name="email" type="email" required class="w-full rounded-xl border border-[var(--color-lavender-ash)] px-4 py-2.5 text-sm focus:outline-none focus:border-[var(--color-accent)]" />
          </div>
          <div>
            <label for="be-beschreibung" class="block text-sm font-semibold mb-1.5" style="color: var(--color-inkwell-purple);">Kurzbeschreibung</label>
            <textarea id="be-beschreibung" name="beschreibung" rows="4" class="w-full rounded-xl border border-[var(--color-lavender-ash)] px-4 py-2.5 text-sm focus:outline-none focus:border-[var(--color-accent)]"></textarea>
          </div>
          <label class="flex items-start gap-2.5 text-xs leading-relaxed" style="color: var(--color-slate-steel);">
            <input type="checkbox" name="einwilligung" required class="mt-0.5" />
            <span>
              Ich bin berechtigt, diesen Betrieb einzutragen, und willige ein,
              dass meine Angaben zur Bearbeitung verwendet werden. Details in der{" "}
              <a href="/datenschutz/" class="underline" style="text-underline-offset: 2px;">Datenschutzerklärung</a>. *
            </span>
          </label>
          <button type="submit" class="btn-primary">Eintrag absenden</button>
        </form>
      ) : (
        <div class="card p-6">
          <p class="text-sm leading-relaxed mb-4" style="color: var(--color-shadow-graphite);">
            Schick uns eine E-Mail an <strong><ObfuscatedEmail email={legal.email} /></strong>{" "}
            mit dem Betreff <strong>"Branchenverzeichnis"</strong> und folgenden Angaben:
          </p>
          <ul class="list-disc pl-5 space-y-1 text-sm mb-4" style="color: var(--color-inkwell-purple);">
            <li>Name des Betriebs und Kategorie</li>
            <li>Adresse (Straße, Hausnummer, PLZ)</li>
            <li>Telefon und Website (optional)</li>
            <li>Kurzbeschreibung (optional)</li>
          </ul>
          <p class="text-xs" style="color: var(--color-slate-steel);">
            Wir prüfen jeden Eintrag redaktionell, bevor er erscheint.
            Ein Online-Formular ist in Vorbereitung.
          </p>
        </div>
      )}

      <div class="mt-10 rounded-3xl px-8 py-10 text-center" style="background: var(--color-porcelain-mist);">
        <h2 class="text-2xl font-bold tracking-tight text-balance mb-3" style="color: var(--color-deep-plum);">
          Mehr als eine Zeile in der Liste?
        </h2>
        <p class="text-sm leading-relaxed max-w-xl mx-auto mb-6" style="color: var(--color-shadow-graphite);">
          Als Premium-Partner steht dein Betrieb ganz oben - mit Logo,
          Beschreibung, Website-Link und einem gesponserten Artikel pro Jahr.
        </p>
        <a href="/werben/premium-partner/" class="btn-primary">Premium-Partner ansehen</a>
      </div>
    </div>
  </section>
</BaseLayout>
