---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Seite nicht gefunden" noindex>
  <div class="container-page py-20 max-w-2xl text-center">
    <p class="eyebrow mb-3">404</p>
    <h1 class="text-4xl sm:text-5xl font-bold mb-4" style="color: var(--color-deep-plum);">
      Hier ist nichts
    </h1>
    <p class="text-lg leading-relaxed mb-8" style="color: var(--color-shadow-graphite);">
      Diese Seite gibt's nicht. Vielleicht hilft eine unserer Hauptseiten weiter.
    </p>
    <a href="/" class="btn-primary">Zur Startseite →</a>
  </div>
</BaseLayout>
