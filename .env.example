# speyer-interaktiv.de — Umgebungsvariablen
# -------------------------------------------
# Lokal als .env kopieren und Werte einsetzen.
# Im Hosting-Panel (Cloudflare Pages, Vercel, Netlify, Hostinger)
# als Secrets/Environment Variables hinterlegen.
#
# .env NICHT committen — steht in .gitignore.

# Stay22 Direct Travel API
# Benötigt für die Stay22*-Components (Live-Hotels via API).
# Account anlegen unter: https://www.stay22.com/partners
# API-Key dann unter Dashboard → API → Keys.
# Wenn nicht gesetzt: Stay22-Live-Blöcke rendern nichts (graceful degrade).
STAY22_API_KEY=

# Web3Forms (Kontakt- und Branchenverzeichnis-Formular)
# Kostenlosen Access-Key holen: https://web3forms.com
# Wenn nicht gesetzt: Formulare rendern nicht, stattdessen wird die
# obfuskierte Kontakt-E-Mail angezeigt (graceful degrade).
# PUBLIC_ Prefix noetig, da der Key im statischen Formular eingebettet wird.
PUBLIC_WEB3FORMS_KEY=
